+FixPSQ::FixPSQ(LAMMPS *lmp, int narg, char **arg) :
+  Fix(lmp, narg, arg)
+{
+  scalar_flag = 1;
+  extscalar = 0;
+  maxwarn = 1;
+
+  if (lmp->citeme) lmp->citeme->add(cite_fix_psq);
+
+  if (narg < 2) error->all(FLERR,"Illegal fix psq command");
+
+  // default values
+  netchg = 0.0;
+  damp = 1.0;
+  nshelliter = 1;
+  inicharge_flag = 0;
+  int i = 1;
+  int ntypes = atom->ntypes;
+  for (i = 1; i < ntypes+1; i++) iniq[i] = 0.0;
+
+  nevery = utils::inumeric(FLERR,arg[3],false,lmp);
+  nshellevery = utils::inumeric(FLERR,arg[4],false,lmp);
+  ncycle = utils::inumeric(FLERR,arg[5],false,lmp);
+  if (nevery < 0 || nshellevery < 0 || ncycle < 0) error->all(FLERR,"Illegal fix psq command");
+
+  tolerance = utils::numeric(FLERR,arg[6],false,lmp);
+  numCG = utils::inumeric(FLERR,arg[7],false,lmp); 
+
+  int iarg = 8;
+  while (iarg < narg) {
+    if (strcmp(arg[iarg],"nowarn") == 0) maxwarn = 0;
+    else if (strcmp(arg[iarg],"maxiter") == 0) {
+      if (iarg+2 > narg)
+        error->all(FLERR,"Illegal fix {} command", style);
+      numCG = utils::numeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"charge") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal fix {} command", style);
+      netchg = utils::numeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"damp") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal fix {} command", style);
+      damp = utils::numeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"nshelliter") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal fix {} command", style);
+      nshelliter = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"initialcharge") == 0) {
+      if (iarg+1+ntypes > narg) error->all(FLERR,"Illegal fix {} command", style);
+      inicharge_flag = 1;
+      for ( i = 1; i < ntypes + 1; i++) iniq[i] = utils::numeric(FLERR,arg[iarg+i],false,lmp);
+      if (ntypes > 126) error->all(FLERR,"Illegal fix {} command. ntypes is larger than 126", style);
+      iarg += 1+ntypes;
+    }
+    else error->all(FLERR,"Illegal fix {} command", style);
+    iarg++;
+  }
+
+  allocate_storage();
+  allocate_SparseCRS(1);
+
+  Binfo = nullptr;
+  khs = nullptr;
+  kappas = nullptr;
+  kappabs = nullptr;
+  Vcis = nullptr;
+  Binfo_local = nullptr;
+  khs_local = nullptr;
+  kappas_local = nullptr;
+  kappabs_local = nullptr;
+  Vcis_local = nullptr;
+
+  n = n_cap = 0;
+  N = nmax = 0;
+  m_fill = m_cap = 0;
+  pack_flag = 0;
+  s = nullptr;
+  qifj = nullptr;
+  qifj_local = nullptr;
+  t = nullptr;
+  nprev = 5;
+
+  // CG
+  p = nullptr;
+  q = nullptr;
+  r = nullptr;
+  Ad = nullptr;
+  Ad_local = nullptr;
+  xnew = nullptr;
+  xnew_local = nullptr;
+  pnew = nullptr;
+  rnew = nullptr;
+  d = nullptr;
+  // Sparse_CRS
+  row_rnk = nullptr;
+  row_rnk_all = nullptr;
+  row_ptr = nullptr;
+  size_n_nz_rnk = nullptr;
+  disp_n_nz_rnk = nullptr;
+  Ad_CRS_col = nullptr;
+  Ad_CRS_val = nullptr;
+  Ad_CRS_local_col = nullptr;
+  Ad_CRS_local_val = nullptr;
+  qifj_CRS_val = nullptr;
+  xnew_CRS_local_val = nullptr;
+
+  // H matrix
+  chis = nullptr;
