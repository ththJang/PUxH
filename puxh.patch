+            CEvd = (-b0*a0 * part1 * part2 + part1 * a0 * b0 * (3*a0*a0*(r0-r_ij)*(r0-r_ij) + c0*(1.0-2.0*a0*r0+2.0*a0*r_ij))) * bos * exp(twbp->bop*(1-pow(bos,twbp->bop2))) / r_ij;
+            /* tally into per-atom energy */
+            double f_tmp, delij[3];
+	    if (system->pair_ptr->evflag) {
+              rvec_ScaledSum(delij, 1., system->my_atoms[i].x,
+                              -1., system->my_atoms[j].x);
+              f_tmp = -CEvd;
+              system->pair_ptr->ev_tally(i,j,natoms,1,0.0,0.0,
+                                         f_tmp,delij[0],delij[1],delij[2]);
+            }
+            rvec_ScaledAdd(workspace->f[i], -CEvd, bonds->select.bond_list[pj].dvec);
+            rvec_ScaledAdd(workspace->f[j], CEvd, bonds->select.bond_list[pj].dvec);
+
+            //printf("bo %lf\t%lf\t%lf\t%lf\t%lf\n",r_ij,bos,e_qm,CEvd_qm,drdbo);
+            if (control->reaxff_rexpon_vdw_flag == 1) {//UNB
