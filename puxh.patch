+/* ---------------------------------------------------------------------- */
+
+void ComputeSpecAtomRexPoN::pack_q(int n)
+{
+  double *q = atom->q;
+  int *mask = atom->mask;
+  int nlocal = atom->nlocal;
+
+
+
+  for (int i = 0; i < nlocal; i++) {
+    if (mask[i] & groupbit) buf[n] = q[i];
+    else buf[n] = 0.0;
+    n += nvalues;
+  }
+}
