+void FixPSQ::init_storage2() 
+{
+  int NN;
+  int nn;
+  int i, j, k, l;
+  int ii, jj;
+  double chi_i, idem_i, idem_j;
+  double qf_i, qf_j;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  tagint *tag = atom->tag;
+  natoms = atom->natoms;
+  int ndim = natoms + 1;
