+/* ---------------------------------------------------------------------- */
+double FixPSQ::parallel_dot_CRS(double *v1, double *v2) {
+  int i, j, ii, jj, inum, itag;
+  int *ilist;
+  int *mask = atom->mask;
+  tagint *tag = atom->tag;
+  tagint **bond_atom = atom->bond_atom;
+  double my_dot, res;
+  my_dot = 0.0;
+  res = 0.0;
+  inum = list->inum;
+  ilist = list->ilist;
+  int natoms = atom->natoms;
+  int nbonds1, nbonds2, cnt;
+
+  for (ii = 0; ii < inum; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    itag = tag[i]; // itag global index
+    nbonds1 = atom->num_bond[i];
+    nbonds2 = counter_num_bond[itag];
+		cnt = row_ptr[itag -1];
+    for (jj = 0; jj < nbonds1; jj++) {
+    my_dot += v1[cnt] * v2[cnt];
+    cnt++;
+    }
+    for (jj = 0; jj < nbonds2; jj++) {
+    my_dot += v1[cnt] * v2[cnt];
+    cnt++;
+    }
+  }
+
+  MPI_Allreduce(&my_dot, &res, 1, MPI_DOUBLE, MPI_SUM, world);
+
+  return res;
+}
