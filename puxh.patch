+/* ---------------------------------------------------------------------- */
+
+double FixPSQ::parallel_vector_acc(double *v, int n) {
+  int i;
+  double my_acc, res;
+
+  int ii;
+  int *ilist;
+
+  ilist = list->ilist;
+
+  my_acc = 0.0;
+  res = 0.0;
+  for (ii = 0; ii < n; ++ii) {
+    i = ilist[ii];
+    if (atom->mask[i] & groupbit) {
+      my_acc += v[i];
+    }
+  }
+
+  MPI_Allreduce(&my_acc, &res, 1, MPI_DOUBLE, MPI_SUM, world);
+
+  return res;
+}
