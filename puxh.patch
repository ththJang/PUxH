+/* ---------------------------------------------------------------------- */
+
+double PairReaxFFRexPoN::init_one(int i, int j)
+{
+  if (setflag[i][j] == 0) error->all(FLERR,"All pair coeffs are not set");
+
+  cutghost[i][j] = cutghost[j][i] = cutmax;
+  return cutmax;
+}
