+/* ---------------------------------------------------------------------- */
+
+void PairReaxFFRexPoN::get_distance(rvec xj, rvec xi, double *d_sqr, rvec *dvec)
+{
+  (*dvec)[0] = xj[0] - xi[0];
+  (*dvec)[1] = xj[1] - xi[1];
+  (*dvec)[2] = xj[2] - xi[2];
+  *d_sqr = SQR((*dvec)[0]) + SQR((*dvec)[1]) + SQR((*dvec)[2]);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairReaxFFRexPoN::set_far_nbr(far_neighbor_data *fdest,
+                            int j, double d, rvec dvec)
+{
+  fdest->nbr = j;
+  fdest->d = d;
+  rvec_Copy(fdest->dvec, dvec);
+  ivec_MakeZero(fdest->rel_box);
+}
