+/* ----------------------------------------------------------------------
+  proc 0 reads from restart file, bcasts
+------------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::read_restart(FILE *fp)
+{
+  read_restart_settings(fp);
+  allocate();
+
+  int i, j;
+  int me = comm->me;
+  for (i = 1; i <= atom->ntypes; i++) {
+    for (j = i; j <= atom->ntypes; j++) {
+      if (me == 0) utils::sfread(FLERR,&setflag[i][j],sizeof(int),1,fp,nullptr,error);
+      MPI_Bcast(&setflag[i][j],1,MPI_INT,0,world);
+      if (setflag[i][j]) {
+        if (me == 0) {
+          utils::sfread(FLERR,&R_UNB[i][j],sizeof(double),1,fp,nullptr,error);
+          utils::sfread(FLERR,&D_UNB[i][j],sizeof(double),1,fp,nullptr,error);
+          utils::sfread(FLERR,&L_UNB[i][j],sizeof(double),1,fp,nullptr,error);
+        }
+        MPI_Bcast(&R_UNB[i][j],1,MPI_DOUBLE,0,world);
+        MPI_Bcast(&D_UNB[i][j],1,MPI_DOUBLE,0,world);
+        MPI_Bcast(&L_UNB[i][j],1,MPI_DOUBLE,0,world);
+      }
+    }
+
+    if (me == 0) {
+      utils::sfread(FLERR, &chi[i], sizeof(double), 1, fp, nullptr, error);
+      utils::sfread(FLERR, &idem[i], sizeof(double), 1, fp, nullptr, error);
+      utils::sfread(FLERR, &rcore[i], sizeof(double), 1, fp, nullptr, error);
+      utils::sfread(FLERR, &polar[i], sizeof(double), 1, fp, nullptr, error);
+      utils::sfread(FLERR, &qcore[i], sizeof(double), 1, fp, nullptr, error);
+      utils::sfread(FLERR, &rshell[i], sizeof(double), 1, fp, nullptr, error);
+      utils::sfread(FLERR, &kstring2[i], sizeof(double), 1, fp, nullptr, error);
+      utils::sfread(FLERR, &kstring4[i], sizeof(double), 1, fp, nullptr, error);
+    }
+  }
+  MPI_Bcast(&chi[1], atom->ntypes, MPI_DOUBLE, 0, world);
+  MPI_Bcast(&idem[1], atom->ntypes, MPI_DOUBLE, 0, world);
+  MPI_Bcast(&rcore[1], atom->ntypes, MPI_DOUBLE, 0, world);
+  MPI_Bcast(&polar[1], atom->ntypes, MPI_DOUBLE, 0, world);
+  MPI_Bcast(&qcore[1], atom->ntypes, MPI_DOUBLE, 0, world);
+  MPI_Bcast(&rshell[1], atom->ntypes, MPI_DOUBLE, 0, world);
+  MPI_Bcast(&kstring2[1], atom->ntypes, MPI_DOUBLE, 0, world);
+  MPI_Bcast(&kstring4[1], atom->ntypes, MPI_DOUBLE, 0, world);
+}
+
+/* ----------------------------------------------------------------------
+  proc 0 writes to restart file
+------------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::write_restart_settings(FILE *fp)
+{
+  fwrite(&swa,sizeof(double),1,fp);
+  fwrite(&swb,sizeof(double),1,fp);
+}
