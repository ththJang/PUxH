+        }
+
+        for (i=0; i < ntypes; ++i) {
+          for (j=i; j < ntypes; ++j) {
+            tbp[i][j].r_s     = tbp[j][i].r_s     = 0.5*(sbp[j].r_s + sbp[i].r_s);
+            if (control->reaxff_rexpon_bond_flag == 0) tbp[i][j].r_s_bo     = tbp[j][i].r_s_bo     = 0.5*(sbp[j].r_s + sbp[i].r_s);
+            tbp[i][j].r_p     = tbp[j][i].r_p     = 0.5*(sbp[j].r_pi + sbp[i].r_pi);
