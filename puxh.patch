+
+  D = (a*m*r+b*p*n+c*l*q)-(a*n*q+b*l*r+c*m*p);
+  (*x)[0] = ((b*r*k+c*m*s+d*n*q)-(b*n*s+c*q*k+d*m*r))/D;
+  (*x)[1]= ((a*n*s+c*p*k+d*l*r)-(a*r*k+c*l*s+d*n*p))/D;
+  (*x)[2] = ((a*q*k+b*l*s+d*m*p)-(a*m*s+b*p*k+d*l*q))/D;
+
