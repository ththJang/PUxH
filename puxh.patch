+        memset(&(fbp[0][0][0][0]),0,sizeof(four_body_header)*n*n*n*n);
+        memset(&tor_flag[0][0][0][0],0,sizeof(char)*n*n*n*n);
+
+        // atomic parameters
+        // four lines per atom type, or 5 if lgvdw != 0
