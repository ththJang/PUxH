+  /* Taper */
+  double Tap[8];    //Tap7, Tap6, Tap5, Tap4, Tap3, Tap2, Tap1, Tap0;
+  double TapHH[8], TapOO[8]; // For H-bond
+
+  /* force calculations */
+  double *CdDelta;    // coefficient of dDelta
+  rvec *f;
+
+  /* omp */
+  rvec *forceReduction;
+  double *CdDeltaReduction;
+  int *valence_angle_atom_myoffset;
