+/* ---------------------------------------------------------------------- */
+int FixPSQ::n_nz_SparseCRS() {
+  int i, j, k;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  int natoms = atom->natoms;
+  int ndim = natoms + 1;
+  tagint *tag = atom->tag;
+  tagint **bond_atom = atom->bond_atom;
+  int jnum, itag, jtag, ktag;
+  int nbondsi, nbondsj;
+  int nn, ii, jj, kk;
+  nn = list->inum;
+  // NN = list->inum + list->gnum;
+  int my_acc, res;
+  my_acc = 0;
+  res = 0;
+
+  int nlocal = atom->nlocal;
+  int *mask = atom->mask;
+  int newton_pair = force->newton_pair, loop;
+  int flag;
+  int nbonds1, nbonds2;
+  int atomj;
+  ilist = list->ilist;
+  firstneigh = list->firstneigh;
+  numneigh = list->numneigh;
+  for (ii = 0; ii < ndim; ii++) {
+    row_rnk[ii] = row_rnk_all[ii] = 0;
+  }
+  for (ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    jnum = numneigh[i]; // i local index
+    itag = tag[i];      // itag global index
+    jlist = firstneigh[i];
+    nbonds1 = atom->num_bond[i];       
+    nbonds2 = counter_num_bond[itag]; 
+                                     
+    for (jj = 0; jj < nbonds1; jj++) {
+      jtag = bond_atom[i][jj];
+      my_acc++;
+      row_rnk[itag]++;
+    }
+    for (jj = 0; jj < nbonds2; jj++) {
+      jtag = counter_bond_atom[itag][jj];
+      my_acc++;
+      row_rnk[itag]++;
+    }
+  }
+
+  int nprocs = comm->nprocs;
+  MPI_Allreduce(&(row_rnk[0]), &(row_rnk_all[0]), ndim, MPI_INT, MPI_SUM, world);
+  row_ptr[0] = 0;
+  for (i = 1; i < ndim; ++i) {
+    row_ptr[i] = row_ptr[i - 1] + row_rnk_all[i];
+  }
+
+  MPI_Allgather(&my_acc, 1, MPI_INT, size_n_nz_rnk, 1, MPI_INT, world);
+  MPI_Allreduce(&my_acc, &res, 1, MPI_INT, MPI_SUM, world);
+
+  disp_n_nz_rnk[0] = 0; // me == 0
+  for (i = 1; i < nprocs; ++i)
+    disp_n_nz_rnk[i] = disp_n_nz_rnk[i - 1] + size_n_nz_rnk[i - 1];
+
+  return res;
+}
+
+/* ---------------------------------------------------------------------- */
+double FixPSQ::find_val(double *A_CRS, int row, int k) {
+  for (int i = row_ptr[row - 1]; i < row_ptr[row]; i++) {
+    if (Ad_CRS_col[i] == k) {
+      return A_CRS[i];
+    }
+  }
+  // If there is no value, give error & return 0 for code compliation
+  error->all(FLERR,"find_val function is failed of fix psq calculation\n");
+  return 0;
+}
