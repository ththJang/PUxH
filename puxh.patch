+/* ---------------------------------------------------------------------- */
+void FixPSQ::calculate_Qdamp() 
+{
+  int i, j;
+  double q_new, q_old;
+  double *q = atom->q;
+  int nn, ii, jj;
+  int *ilist;
+  tagint *tag = atom->tag;
+  tagint **bond_atom = atom->bond_atom;
+  int natoms = atom->natoms;
+  double temp;
+  nn = list->inum;
