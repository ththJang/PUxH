+
+namespace LAMMPS_NS {
+
+class FixReaxFFRexPoN : public Fix {
+  friend class PairReaxFFRexPoN;
+  //friend class PairReaxFFRexPoNOMP; //Not Implemented
+
+ public:
+  FixReaxFFRexPoN(class LAMMPS *, int, char **);
+  ~FixReaxFFRexPoN() override;
+  int setmask() override;
+
+  double memory_usage() override;
+  void grow_arrays(int) override;
+  void copy_arrays(int, int, int) override;
+  int pack_exchange(int, double *) override;
