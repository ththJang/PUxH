+/* ---------------------------------------------------------------------- */
+
+void PairReaxFFRexPoN::settings(int narg, char **arg)
+{
+  if (narg < 1) error->all(FLERR,"Illegal pair_style command");
+
+  if (comm->me == 0) {
+    // read name of control file or use default controls
+
+    if (strcmp(arg[0],"NULL") == 0) {
+      api->control->tabulate = 0;
+
+      api->control->bond_cut = 5.;
+      api->control->hbond_cut = 7.50;
+      api->control->thb_cut = 0.001;
+      api->control->thb_cutsq = 0.00001;
+      api->control->bg_cut = 0.3;
+
+      api->control->nthreads = 1;
+
+    } else Read_Control_File(arg[0], api->control);
+  }
+  MPI_Bcast(api->control,sizeof(control_params),MPI_CHAR,0,world);
+
+  // must reset these to local values after broadcast
+  api->control->me = comm->me;
+  api->control->error_ptr = error;
+  api->control->lmp_ptr = lmp;
+
+  // default values
+
+  api->control->reaxff_rexpon_bond_flag = 1;
+  api->control->reaxff_rexpon_angle_flag = 1;
+  // For vdw & hbond, 1 is for Normal RexPon and 2 is for Water RexPoN
+  api->control->reaxff_rexpon_vdw_flag = 1;
+  api->control->reaxff_rexpon_hbond_flag = 1;
+  api->control->water_flag = 0; //For water RexPoN, uses another vdW & H-Bond form
+  api->control->lgflag = 0;
+  api->control->nonreactive_flag = 0; // If 1, bond order between not connected bond is 0. Except angle term
+  api->control->enobondsflag = 1;
+  api->system->mincap = REAX_REXPON_MIN_CAP;
+  api->system->minhbonds = REAX_REXPON_MIN_HBONDS;
+  api->system->safezone = REAX_REXPON_SAFE_ZONE;
+  api->system->saferzone = REAX_REXPON_SAFER_ZONE;
+
+  // process optional keywords
+
+  int iarg = 1;
+
+  while (iarg < narg) {
+    // We can choose bond, angle, vdw, hbond term from RexPoN(1) or ReaxFF(0)
+    if (strcmp(arg[iarg],"bond") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->control->reaxff_rexpon_bond_flag = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"angle") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->control->reaxff_rexpon_angle_flag = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"vdw") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->control->reaxff_rexpon_vdw_flag = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"hbond") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      if (strcmp(arg[iarg+1],"NULL") == 0) {
+        api->control->reaxff_rexpon_hbond_flag = -1;
+        api->control->hbond_cut = 0.0;
+      }
+      else api->control->reaxff_rexpon_hbond_flag = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+      if (api->control->reaxff_rexpon_hbond_flag != 0) api->control->hbond_cut = 5.56;//4.60+0.96
+    } else if (strcmp(arg[iarg],"enobonds") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->control->enobondsflag = utils::logical(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"nonreactive") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->control->nonreactive_flag = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"lgvdw") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->control->lgflag = utils::logical(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"safezone") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->system->safezone = utils::numeric(FLERR,arg[iarg+1],false,lmp);
+      if (api->system->safezone < 0.0)
+        error->all(FLERR,"Illegal pair_style reaxff/rexpon safezone command");
+      api->system->saferzone = api->system->safezone*1.2 + 0.2;
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"mincap") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->system->mincap = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      if (api->system->mincap < 0)
+        error->all(FLERR,"Illegal pair_style reaxff/rexpon mincap command");
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"minhbonds") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->system->minhbonds = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      if (api->system->minhbonds < 0)
+        error->all(FLERR,"Illegal pair_style reaxff/rexpon minhbonds command");
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"list/blocking") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      list_blocking_flag = utils::logical(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else if (strcmp(arg[iarg],"tabulate") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+      api->control->tabulate = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      if (api->control->tabulate < 0)
+        error->all(FLERR,"Illegal pair_style reaxff/rexpon tabulate command");
+      iarg += 2;
+    } else error->all(FLERR,"Illegal pair_style reaxff/rexpon command");
+  }
+  if (api->control->reaxff_rexpon_vdw_flag) api->control->lgflag = 1;
+  if (api->control->reaxff_rexpon_vdw_flag == 2 && api->control->reaxff_rexpon_hbond_flag == 2) api->control->water_flag = 1;
+
+  // Read control file one more time
+  if (comm->me == 0) {
+    if (strcmp(arg[0],"NULL") == 0) {
+    } else Read_Control_File(arg[0], api->control);
+  }
+  MPI_Bcast(api->control,sizeof(control_params),MPI_CHAR,0,world);
+
+  // must reset these to local values after broadcast
+  api->control->me = comm->me;
+  api->control->error_ptr = error;
+  api->control->lmp_ptr = lmp;
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairReaxFFRexPoN::coeff(int nargs, char **args)
+{
+  if (!allocated) allocate();
+
+  if (nargs != 3 + atom->ntypes)
+    error->all(FLERR,"Incorrect args for pair coefficients");
+
+  // insure I,J args are * *
+
+  if (strcmp(args[0],"*") != 0 || strcmp(args[1],"*") != 0)
+    error->all(FLERR,"Incorrect args for pair coefficients");
+
+  // read ffield file
+
+  Read_Force_Field(args[2], &(api->system->reax_rexpon_param), api->control, world);
+
+  // read args that map atom types to elements in potential file
+  // map[i] = which element the Ith atom type is, -1 if "NULL"
+
+  int itmp = 0;
+  int nreax_rexpon_types = api->system->reax_rexpon_param.num_atom_types;
+  for (int i = 3; i < nargs; i++) {
+    if (strcmp(args[i],"NULL") == 0) {
+      map[i-2] = -1;
+      itmp ++;
+      continue;
+    }
+  }
+
+  int n = atom->ntypes;
+
+  // pair_coeff element map
+  for (int i = 3; i < nargs; i++)
+    for (int j = 0; j < nreax_rexpon_types; j++)
+      if (utils::lowercase(args[i]) == utils::lowercase(api->system->reax_rexpon_param.sbp[j].name)) {
+        map[i-2] = j;
+        itmp ++;
+      }
+
+  // error check
+  if (itmp != n)
+    error->all(FLERR,"Non-existent ReaxFF/RexPoN type");
+
+  for (int i = 1; i <= n; i++)
+    for (int j = i; j <= n; j++)
+      setflag[i][j] = 0;
+
+  // set setflag i,j for type pairs where both are mapped to elements
+
+  int count = 0;
+  for (int i = 1; i <= n; i++)
+    for (int j = i; j <= n; j++)
+      if (map[i] >= 0 && map[j] >= 0) {
+        setflag[i][j] = 1;
+        count++;
+      }
+
+  if (count == 0) error->all(FLERR,"Incorrect args for pair coefficients");
+
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairReaxFFRexPoN::init_style()
+{
+  api->system->n = atom->nlocal; // my atoms
+  api->system->N = atom->nlocal + atom->nghost; // mine + ghosts
+  api->system->wsize = comm->nprocs;
+
+  if (atom->tag_enable == 0)
+    error->all(FLERR,"Pair style reaxff/rexpon requires atom IDs");
+  if (force->newton_pair == 0)
+    error->all(FLERR,"Pair style reaxff/rexpon requires newton pair on");
+
+  // need a half neighbor list w/ Newton off and ghost neighbors
+  // built whenever re-neighboring occurs
+
+  neighbor->add_request(this, NeighConst::REQ_GHOST | NeighConst::REQ_NEWTON_OFF);
+
+  cutmax = MAX3(api->control->nonb_cut, api->control->hbond_cut, api->control->bond_cut);
+  if ((cutmax < 2.0*api->control->bond_cut) && (comm->me == 0))
+    error->warning(FLERR,"Total cutoff < 2*bond cutoff. May need to use an "
+                   "increased neighbor list skin.");
+
+  if (fix_reaxff_rexpon == nullptr)
+    fix_reaxff_rexpon = dynamic_cast<FixReaxFFRexPoN *>( modify->add_fix(fmt::format("{} all REAXFF_REXPON",fix_id)));
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairReaxFFRexPoN::setup()
+{
+  int oldN;
+  int mincap = api->system->mincap;
+  double safezone = api->system->safezone;
+
+  api->system->n = atom->nlocal; // my atoms
+  api->system->N = atom->nlocal + atom->nghost; // mine + ghosts
+  oldN = api->system->N;
+
+  if (setup_flag == 0) {
+
+    setup_flag = 1;
+
+    int *num_bonds = fix_reaxff_rexpon->num_bonds;
+    int *num_hbonds = fix_reaxff_rexpon->num_hbonds;
+
+    // determine the local and total capacity
+
+    api->system->local_cap = MAX((int)(api->system->n * safezone), mincap);
+    api->system->total_cap = MAX((int)(api->system->N * safezone), mincap);
+
+    // initialize my data structures
+
+    PreAllocate_Space(api->system, api->workspace);
+    write_reax_rexpon_atoms();
+
+    api->system->wsize = comm->nprocs;
+
+    int num_nbrs = estimate_reax_rexpon_lists();
+    if (num_nbrs < 0)
+      error->all(FLERR,"Too many neighbors for pair style reaxff/rexpon");
+
+    Make_List(api->system->total_cap,num_nbrs,TYP_FAR_NEIGHBOR,api->lists+FAR_NBRS);
+    (api->lists+FAR_NBRS)->error_ptr=error;
+
+    write_reax_rexpon_lists();
+
+    Initialize(api->system,api->control,api->data,api->workspace,&api->lists,world);
+    for (int k = 0; k < api->system->N; ++k) {
+      num_bonds[k] = api->system->my_atoms[k].num_bonds;
+      num_hbonds[k] = api->system->my_atoms[k].num_hbonds;
+    }
+
+  } else {
+
+    // fill in reax datastructures
+
+    write_reax_rexpon_atoms();
+
+    // reset the bond list info for new atoms
+
+    for (int k = oldN; k < api->system->N; ++k)
+      Set_End_Index(k, Start_Index(k, api->lists+BONDS), api->lists+BONDS);
+
+    // check if I need to shrink/extend my data-structs
+
+    ReAllocate(api->system, api->control, api->data, api->workspace, &api->lists);
+  }
+}
