+  for (int i = ilo; i <= ihi; i++) {
+    k[i] = k_one;
+    theta0[i] = DEG2RAD * theta0_one;
+    setflag[i] = 1;
+    count++;
+  }
+
+  if (count == 0) error->all(FLERR, "Incorrect args for angle coefficients");
+}
