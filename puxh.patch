+#define CUBE(x) ((x)*(x)*(x))
+
+/* ---------------------------------------------------------------------- */
+
+PairCoulPqeqgauss::PairCoulPqeqgauss(LAMMPS *lmp) : Pair(lmp)
+{
+  ewaldflag = 1;
+  single_enable = 0;
+  writedata = 1;
+  ghostneigh = 1;
+}
+
+/* ---------------------------------------------------------------------- */
+
+PairCoulPqeqgauss::~PairCoulPqeqgauss()
+{
+  if (copymode) return;
+
+  if (allocated) {
+    memory->destroy(setflag);
+    memory->destroy(cutsq);
+
+    memory->destroy(chi);
+    memory->destroy(idem);
+    memory->destroy(rcore);
+    memory->destroy(polar);
+    memory->destroy(qcore);
+    memory->destroy(rshell);
+    memory->destroy(kstring2);
+    memory->destroy(kstring4);
+    memory->destroy(alphass);
+    memory->destroy(alphasc);
+    memory->destroy(alphacc);
+    memory->destroy(swab);
+    memory->destroy(cutghost);
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairCoulPqeqgauss::compute(int eflag, int vflag)
+{
+  int i, j, ii, jj, inum, jnum, itype, jtype, flag;
+  double qi,qj,xi,xj,yi,yj,zi,zj, delx, dely, delz, ecoul, fpair;
+  double r, rsq, r2inv, rinv, forcecoul, factor_coul;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  
+  int polari,polarj;
+  double alpha,chii,idemi,kstring2i,kstring4i;
+  double shell_eng,coulombr,dcoulombr;
+  double q1,q2,qcorei,qcorej,qshelli,qshellj,rsxi,rsxj,rsyi,rsyj,rszi,rszj;
+
+
+  ecoul = 0.0;
+  ev_init(eflag, vflag);
+
+  double **x = atom->x;
+  double **f = atom->f;
+  double *q = atom->q;
+  double **rsx = atom->rsx;
+  int *type = atom->type;
+  int *tag = atom->tag;
+  double SMALL = 0.0001;
+  int nlocal = atom->nlocal;
+  double *special_coul = force->special_coul;
+  int newton_pair = force->newton_pair;
+  double qqrd2e = force->qqrd2e;
+  double qe2f = force->qe2f;
+
+  inum = list->inum;
+  ilist = list->ilist;
+  numneigh = list->numneigh;
+  firstneigh = list->firstneigh;
+
+  // loop over neighbors of my atoms
+
+  for (ii = 0; ii < inum; ii++) {
+    i = ilist[ii];
+    qi = q[i];
+    xi = x[i][0];
+    yi = x[i][1];
+    zi = x[i][2];
+    itype = type[i];
+    polari = polar[itype];
+    chii = qe2f*chi[itype];
+    idemi = qe2f*idem[itype];
+    jlist = firstneigh[i];
+    jnum = numneigh[i];
+
+    // Self energy, only on i atom
+    if (polari && atom->pqeq_flag) {
+      kstring2i = kstring2[itype];
+      kstring4i = kstring4[itype];
+      qcorei = qcore[itype];
+      qshelli = -qcorei;
+      rsxi = rsx[i][0];
+      rsyi = rsx[i][1];
+      rszi = rsx[i][2];
+      rsq = rsxi*rsxi + rsyi*rsyi + rszi*rszi;
+      r = sqrt(rsq);
+      shell_eng = 0.50 * kstring2i * rsq + kstring4i * rsq * rsq;
+    }
+    else shell_eng = qcorei = 0.0;
+
+    if (eflag) ecoul = chii * qi + 0.5 * idemi * qi * qi + shell_eng;
+
+    if (evflag) ev_tally(i,i,nlocal,0,0.0,ecoul,0.0,0.0,0.0,0.0);
+
+    q1 = qcorei + qi;
+
+    if (!ewald_flag) {
+    for (jj = 0; jj < jnum; jj++) {
+      j = jlist[jj];
+      factor_coul = special_coul[sbmask(j)];
+      j &= NEIGHMASK;
+
+      xj = x[j][0];
+      yj = x[j][1];
+      zj = x[j][2];
+
+      delx = xi - xj;
+      dely = yi - yj;
+      delz = zi - zj;
+      rsq = delx * delx + dely * dely + delz * delz;
+      jtype = type[j];
+
+      flag = 0;
+      if (rsq <= SQR(swb)) {
+        if (j < nlocal) flag = 1;
+        else if (tag[i] < tag[j]) flag = 1;
+        else if (tag[i] == tag[j]) {
+          if (-delz > SMALL) flag = 1;
+          else if (fabs(delz) < SMALL) {
+            if (-dely > SMALL) flag = 1;
+            else if (fabs(dely) < SMALL && -delx > SMALL)
+            flag = 1;
+          }
+        }
+      }
+      if (rsq <= SQR(swb)) {
+      //if (flag) { //mino: I don't know why but this shows identical results with 2017 version
+        qj = q[j];
+        jtype = type[j];
+        polarj = polar[jtype];
+
+        if (polarj) {
+          qcorej = qcore[jtype];
+          qshellj = -qcore[jtype];
+          rsxj = rsx[j][0];
+          rsyj = rsx[j][1];
+          rszj = rsx[j][2];
+        } else qcorej = 0.0; 
+
+        q2 = qcorej + qj;
+
+        // Core - Core
+        alpha = alphacc[itype][jtype];
+        r = sqrt(rsq);
+        coulomb(r, alpha, &coulombr, &dcoulombr);
+        fpair = -dcoulombr * q1 * q2 /r;
+
+        f[i][0] += factor_coul * delx * fpair;
+        f[i][1] += factor_coul * dely * fpair;
+        f[i][2] += factor_coul * delz * fpair;
+        if (newton_pair || j < nlocal) {
+          f[j][0] -= factor_coul * delx * fpair;
+          f[j][1] -= factor_coul * dely * fpair;
+          f[j][2] -= factor_coul * delz * fpair;
+        }
+
+        if (eflag) ecoul = factor_coul * coulombr * q1 * q2;
+
+        if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+        
+        // Shell - Shell
+        if (polari && polarj) {
+          alpha = alphass[itype][jtype];
+          delx = rsxi - rsxj + delx;
+          dely = rsyi - rsyj + dely;
+          delz = rszi - rszj + delz;
+          rsq = delx * delx + dely * dely + delz * delz;
+          r = sqrt(rsq);
+          coulomb(r, alpha, &coulombr, &dcoulombr);
+          fpair = -dcoulombr * qshelli * qshellj /r;
+  
+          f[i][0] += factor_coul * delx * fpair;
+          f[i][1] += factor_coul * dely * fpair;
+          f[i][2] += factor_coul * delz * fpair;
+          if (newton_pair || j < nlocal) {
+            f[j][0] -= factor_coul * delx * fpair;
+            f[j][1] -= factor_coul * dely * fpair;
+            f[j][2] -= factor_coul * delz * fpair;
+          }
+
+          if (eflag) ecoul = factor_coul * coulombr * qshelli * qshellj;
+
+          if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+ 
+        }
+
+        // Shell i - Core j
+        if (polari) {
+          alpha = alphasc[itype][jtype];
+          delx = (rsxi + xi) - xj;
+          dely = (rsyi + yi) - yj;
+          delz = (rszi + zi) - zj;
+          rsq = delx * delx + dely * dely + delz * delz;
+          r = sqrt(rsq);
+          coulomb(r, alpha, &coulombr, &dcoulombr);
+          fpair = -dcoulombr * qshelli * q2 /r;
+  
+          f[i][0] += factor_coul * delx * fpair;
+          f[i][1] += factor_coul * dely * fpair;
+          f[i][2] += factor_coul * delz * fpair;
+          if (newton_pair || j < nlocal) {
+            f[j][0] -= factor_coul * delx * fpair;
+            f[j][1] -= factor_coul * dely * fpair;
+            f[j][2] -= factor_coul * delz * fpair;
+          }
+
+          if (eflag) ecoul = factor_coul * coulombr * qshelli * q2;
+
+          if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+ 
+        }
+
+        // Core i - Shell j
+        if (polarj) {
+          alpha = alphasc[jtype][itype];
+          delx = xi - (rsxj + xj);
+          dely = yi - (rsyj + yj);
+          delz = zi - (rszj + zj);
+          rsq = delx * delx + dely * dely + delz * delz;
+          r = sqrt(rsq);
+          coulomb(r, alpha, &coulombr, &dcoulombr);
+          fpair = -dcoulombr * q1 * qshellj /r;
+  
+          f[i][0] += factor_coul * delx * fpair;
+          f[i][1] += factor_coul * dely * fpair;
+          f[i][2] += factor_coul * delz * fpair;
+          if (newton_pair || j < nlocal) {
+            f[j][0] -= factor_coul * delx * fpair;
+            f[j][1] -= factor_coul * dely * fpair;
+            f[j][2] -= factor_coul * delz * fpair;
+          }
+          
+          if (eflag) ecoul = factor_coul * coulombr * q1 * qshellj;
+
+          if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+ 
+        }
+      }
+      }
+    }
+  }
+
+  if (vflag_fdotr) virial_fdotr_compute();
+}
