+/* ---------------------------------------------------------------------- */
+
+void FixPSQ::compute_H() {
+  int inum, jnum, *ilist, *jlist, *numneigh, **firstneigh;
+  int i, j, ii, jj, flag;
+  double **x, SMALL = 0.0001;
+  double dx, dy, dz, r_sqr;
+  int itag, jtag;
+
+  int *type = atom->type;
+  tagint *tag = atom->tag;
+  x = atom->x;
+  int *mask = atom->mask;
+  int natoms = atom->natoms;
+  int ndim = natoms + 1;
+
+  inum = list->inum;
+  ilist = list->ilist;
+  numneigh = list->numneigh;
+  firstneigh = list->firstneigh;
+
+  // fill in the H matrix
+	m_fill = 0;
+  r_sqr = 0;
+  for (ii = 0; ii < inum; ii++) {
+    i = ilist[ii];
+    if (mask[i] & groupbit) {
+      jlist = firstneigh[i];
+      jnum = numneigh[i];
+      itag = tag[i];
+			H.firstnbr[i] = m_fill;
+
+      for (jj = 0; jj < jnum; jj++) {
+        j = jlist[jj];
+        j &= NEIGHMASK;
+        jtag = tag[j];
+        dx = x[j][0] - x[i][0];
+        dy = x[j][1] - x[i][1];
+        dz = x[j][2] - x[i][2];
+        r_sqr = SQR(dx) + SQR(dy) + SQR(dz);
+
+        flag = 0;
+        if (r_sqr <= SQR(swb)) {
+          if (j < n)
+            flag = 1;
+          else if (itag < jtag)
+            flag = 1;
+          else if (itag == jtag) {
+            if (dz > SMALL)
+              flag = 1;
+            else if (fabs(dz) < SMALL) {
+              if (dy > SMALL)
+                flag = 1;
+              else if (fabs(dy) < SMALL && dx > SMALL)
+                flag = 1;
+            }
+          }
+
+        }
+
+        if (flag) {
+	        H.jlist[m_fill] = j;
+          H.val[m_fill] = calculate_H( sqrt(r_sqr), alphacc[type[i]][type[j]] );
+          m_fill++;
+        }
+      }
+      H.numnbrs[i] = m_fill - H.firstnbr[i];
+    }
+  }
+
+}
+
+/* ---------------------------------------------------------------------- */
+
+double FixPSQ::calculate_H(double r, double alphacc) {
+  double Taper, coul;
+
+  if ((r > swa) && taper_flag) {
+    Taper = Tap[7];
+    for (int n = 6; n >= 0; n--) {
+      Taper = Taper * r + Tap[n];
+    }
+  } else {
+    Taper = 1.0;
+  }
+
+  coul = erf(alphacc * r) / r;
+
+  return Taper * EV_TO_KCAL_PER_MOL * coul;
+}
