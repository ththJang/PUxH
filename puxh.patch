+              s0 = twbp->lgre;
+              s1 = twbp->s1;
+              s2 = twbp->s2;
+              s3 = twbp->s3;
+              s4 = twbp->s4;
+              s5 = twbp->s5;
+
+              L2 = le*le;
+              L3 = le*L2;
+              L4 = L2*L2;
+              L5 = le*L4;
+
+              alf_vdW = alf_vdW/le;
+              s1 = s1/le;
+              s2 = s2/L2;
+              s3 = s3/L3;
+              s4 = s4/L4;
+              s5 = s5/L5;
+
+              dr = r_ij-re_vdW;
+              dr2 = dr*dr;
+              dr3 = dr*dr2;
+              dr4 = dr*dr3;
+              dr5 = dr*dr4;
+
+              exp1 = -d_vdW * exp(-alf_vdW * dr);
+              exp2 = s0 + s1*dr + s2*dr2 + s3*dr3 + s4*dr4 + s5*dr5;
+
+              dexp1 = -alf_vdW * exp1;
+              dexp2 = s1 + 2*s2*dr + 3*s3*dr2 + 4*s4*dr3 + 5*s5*dr4;
+
+              e_nb = Tap * (1.0-bos/1.01) * exp1 * exp2;
+              de_nb = drdbo * (dexp1*exp2 + exp1*dexp2);
+
+              CEvd_nb = Tap * (1.0-bos/1.01) * de_nb + dTap * drdbo * e_nb / Tap * r_ij - Tap * exp1 * exp2 / 1.01;
+
+              //printf("bond %lf\t%lf\n",CEvd_nb,drdbo);
+
+              e_b = e_qm;// - e_nb;
+              //printf("i j e_qm e_b e_nb r bo %d\t%d\t%lf\t%lf\t%lf\t%lf\t%lf\n",system->my_atoms[i].orig_id,system->my_atoms[j].orig_id,e_qm,e_b,e_nb,r_ij,bos);
+              CEbo = CEvd_qm;// - CEvd_nb;//In ReaxFF, it is dE/dBO, but here, it is dE/dr -> Should be check, mino
+              //printf("CEbo CEvd_qm CEvd_nb %lf\t%lf\t%lf\n",CEbo,CEvd_qm,CEvd_nb);
+            }
