+void FixPSQ::Admatrix(double *x) {
+  int i, j, k;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  int natoms = atom->natoms;
+  int ndim = natoms + 1;
+  tagint *tag = atom->tag;
+  tagint **bond_atom = atom->bond_atom;
+  int jnum, itag, jtag, ktag;
+  double *q = atom->q;
+  double qi, qj;
+  int nbondsi, nbondsj;
+  int nn, ii, jj, kk;
+  nn = list->inum;
+  // NN = list->inum + list->gnum;
+  int me = comm->me;
+  int nlocal = atom->nlocal;
+  int *mask = atom->mask;
+  int newton_pair = force->newton_pair, loop;
+  int flag;
+  int nbonds1, nbonds2;
+  int atomj;
+  ilist = list->ilist;
+  firstneigh = list->firstneigh;
+  numneigh = list->numneigh;
+  int cnt;
+  double temp_qifj;
+  for (ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    jnum = numneigh[i]; // i local index
+    itag = tag[i];      // itag global index
+    jlist = firstneigh[i];
+    nbonds1 = atom->num_bond[i];      // local i
+    nbonds2 = counter_num_bond[itag]; // global i
+    cnt = row_ptr[itag - 1];
+    for (jj = 0; jj < nbonds1; jj++) { 
+      jtag = bond_atom[i][jj];
+      nbondsi = atom->num_bond[i];
+      nbondsj = global_num_bond[jtag];    
+      for (int m = 0; m < nbondsi; m++) { 
+        k = bond_atom[i][m];              
+        temp_qifj = find_val(x, itag, k);
+        Ad_CRS_local_val[cnt] += (kappas[itag * natoms + jtag] + kappabs[itag * natoms + jtag] + kappas[itag * natoms + k] + kappabs[itag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      for (int m = 0; m < nbondsj; m++) { 
+        k = global_bond_atom[jtag][m];    
+        temp_qifj = find_val(x, jtag, k);
+        Ad_CRS_local_val[cnt] -= (kappas[jtag * natoms + itag] + kappabs[jtag * natoms + itag] + kappas[jtag * natoms + k] + kappabs[jtag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      nbondsi = counter_num_bond[itag];
+      nbondsj = counter_num_bond[jtag];
+      for (int m = 0; m < nbondsi; m++) { 
+        k = counter_bond_atom[itag][m];
+        temp_qifj = find_val(x, itag, k);
+        Ad_CRS_local_val[cnt] += (kappas[itag * natoms + jtag] + kappabs[itag * natoms + jtag] + kappas[itag * natoms + k] + kappabs[itag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      for (int m = 0; m < nbondsj; m++) {
+        k = counter_bond_atom[jtag][m];
+        temp_qifj = find_val(x, jtag, k);
+        Ad_CRS_local_val[cnt] -= (kappas[jtag * natoms + itag] + kappabs[jtag * natoms + itag] + kappas[jtag * natoms + k] + kappabs[jtag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      Ad_CRS_local_val[cnt] += Vcis[itag] - Vcis[jtag];
+      cnt++;
+    }
+    for (jj = 0; jj < nbonds2; jj++) { 
+      jtag = counter_bond_atom[itag][jj];
+      nbondsi = atom->num_bond[i];
+      nbondsj = global_num_bond[jtag];
+      for (int m = 0; m < nbondsi; m++) { 
+        k = bond_atom[i][m];             
+        temp_qifj = find_val(x, itag, k);
+        Ad_CRS_local_val[cnt] += (kappas[itag * natoms + jtag] + kappabs[itag * natoms + jtag] + kappas[itag * natoms + k] + kappabs[itag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      for (int m = 0; m < nbondsj; m++) { 
+        k = global_bond_atom[jtag][m];    
+        temp_qifj = find_val(x, jtag, k);
+        Ad_CRS_local_val[cnt] -= (kappas[jtag * natoms + itag] + kappabs[jtag * natoms + itag] + kappas[jtag * natoms + k] + kappabs[jtag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      nbondsi = counter_num_bond[itag];
+      nbondsj = counter_num_bond[jtag];
+      for (int m = 0; m < nbondsi; m++) { 
+        k = counter_bond_atom[itag][m];
+        temp_qifj = find_val(x, itag, k);
+        Ad_CRS_local_val[cnt] += (kappas[itag * natoms + jtag] + kappabs[itag * natoms + jtag] + kappas[itag * natoms + k] + kappabs[itag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      for (int m = 0; m < nbondsj; m++) {
+        k = counter_bond_atom[jtag][m];
+        temp_qifj = find_val(x, jtag, k);
+        Ad_CRS_local_val[cnt] -= (kappas[jtag * natoms + itag] + kappabs[jtag * natoms + itag] + kappas[jtag * natoms + k] + kappabs[jtag * natoms + k]) * 0.5 * temp_qifj;
+      }
+      Ad_CRS_local_val[cnt] += Vcis[itag] - Vcis[jtag];
+      cnt++;
+    }
+  }
+}
