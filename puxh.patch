+  api->system->omp_active = 0;
+
+  fix_reaxff_rexpon = nullptr;
+  tmpid = nullptr;
+  tmpbo = nullptr;
+
+  nextra = 14;
+  pvector = new double[nextra];
+
+  setup_flag = 0;
+  fixspecies_flag = 0;
+
+  nmax = 0;
+
+  list_blocking_flag = 0;
+}
