+#define SQR(x) ((x)*(x))
+#define CUBE(x) ((x)*(x)*(x))
+
+/* ---------------------------------------------------------------------- */
+
+PairUNBCoulCut::PairUNBCoulCut(LAMMPS *lmp) : Pair(lmp)
+{
+  single_enable = 0;
+  implicit = 0;
+  writedata = 1;
+  restartinfo = 0;
+}
+
+/* ---------------------------------------------------------------------- */
+
+PairUNBCoulCut::~PairUNBCoulCut()
+{
+  if (copymode) return;
+
+  if (allocated) {
+    memory->destroy(setflag);
+    memory->destroy(cutsq);
+    memory->destroy(cut);
+
+    // UNB Part
+    memory->destroy(R_UNB);
+    memory->destroy(D_UNB);
+    memory->destroy(L_UNB);
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairUNBCoulCut::compute(int eflag, int vflag)
+{
+  int i,j,ii,jj,inum,jnum,itype,jtype,itable;
+  double qtmp,xtmp,ytmp,ztmp,delx,dely,delz,evdwl,ecoul,fpair;
+  double fraction,table;
+  double r,rinv,r2inv,forcecoul,forcelj,factor_coul,factor_lj;
+  double grij,expm2,prefactor,t,erfc;
+  int *ilist,*jlist,*numneigh,**firstneigh;
+  double rsq;
+
+  double taper,dtaper;
+  double R,D,L;
+  double r2,r3,r4,r5;
+  double exp1,exp2,dexp1,dexp2,e_vdW,de_vdW;
+
+  evdwl = ecoul = 0.0;
+  ev_init(eflag,vflag);
+
+  double **x = atom->x;
+  double **f = atom->f;
+  double *q = atom->q;
+  int *type = atom->type;
+  int nlocal = atom->nlocal;
+  double *special_coul = force->special_coul;
+  double *special_lj = force->special_lj;
+  int newton_pair = force->newton_pair;
+  double qqrd2e = force->qqrd2e;
+
+  inum = list->inum;
+  ilist = list->ilist;
+  numneigh = list->numneigh;
+  firstneigh = list->firstneigh;
+
+  // loop over neighbors of my atoms
+
+  for (ii = 0; ii < inum; ii++) {
+    i = ilist[ii];
+    qtmp = q[i];
+    xtmp = x[i][0];
+    ytmp = x[i][1];
+    ztmp = x[i][2];
+    itype = type[i];
+    jlist = firstneigh[i];
+    jnum = numneigh[i];
+
+    for (jj = 0; jj < jnum; jj++) {
+      j = jlist[jj];
+      factor_lj = special_lj[sbmask(j)];
+      factor_coul = special_coul[sbmask(j)];
+      j &= NEIGHMASK;
+
+      delx = xtmp - x[j][0];
+      dely = ytmp - x[j][1];
+      delz = ztmp - x[j][2];
+      rsq = delx*delx + dely*dely + delz*delz;
+      jtype = type[j];
+
+      if (rsq < cut_bothsq) {
+        r2inv = 1.0/rsq;
+
+        if (rsq < cutsq[itype][jtype]) {
+          r2inv = 1.0 / rsq;
+          rinv = sqrt(r2inv);
+          forcecoul = qqrd2e * qtmp * q[j] * rinv;
+        } else forcecoul = 0.0;
+
+        if (rsq < cut_ljsq) {
+          // Init Taper for UNB
+          if (taper_flag) {
+            taper = Tap[7];
+            dtaper = dTap[7];
+            for (int n = 6; n >= 0; n--) {
+              taper = taper * sqrt(rsq) + Tap[n];
+              dtaper = dtaper * sqrt(rsq) + dTap[n];
+            }
+            if (rsq >= cut_ljsq) {
+              taper = 0.0;
+              dtaper = 0.0;
+            }
+          }
+          else {
+            taper = 1.0;
+            dtaper = 0.0;
+          }
+
+          // UNB Part
+          R = R_UNB[itype][jtype];
+          D = D_UNB[itype][jtype];
+          L = L_UNB[itype][jtype];
+
+          r = (sqrt(rsq) - R) / L;
+          r2 = r * r;
+          r3 = r2 * r;
+          r4 = r3 * r;
+          r5 = r4 * r;
+
+          exp1 = -D * exp(-beta * r);
+          exp2 = s0 + s1 * r + s2 * r2 + s3 * r3 + s4 * r4 + s5 * r5;
+          e_vdW = exp1 * exp2;
+
+          dexp1 = -beta * exp1 / L;
+          dexp2 = (s1 + 2.0 * s2 * r + 3.0 * s3 * r2 + 4.0 * s4 * r3 + 5.0 * s5 * r4) / L;
+          de_vdW = (dexp1 * exp2 + exp1 * dexp2);
+
+          forcelj = -(taper * de_vdW + dtaper * e_vdW) / sqrt(rsq);
+        } else forcelj = 0.0;
+
+        fpair = factor_coul * forcecoul * r2inv + factor_lj*forcelj;
+
+        f[i][0] += delx*fpair;
+        f[i][1] += dely*fpair;
+        f[i][2] += delz*fpair;
+        if (newton_pair || j < nlocal) {
+          f[j][0] -= delx*fpair;
+          f[j][1] -= dely*fpair;
+          f[j][2] -= delz*fpair;
+        }
+
+        if (eflag) {
+          if (rsq < cutsq[itype][jtype]) {
+            ecoul = factor_coul * qqrd2e * qtmp * q[j] * rinv;
+          } else ecoul = 0.0;
+
+          if (rsq < cut_ljsq) {
+            // Init Taper for UNB
+            if (taper_flag) {
+              taper = Tap[7];
+              dtaper = dTap[7];
+              for (int n = 6; n >= 0; n--) {
+                taper = taper * sqrt(rsq) + Tap[n];
+                dtaper = dtaper * sqrt(rsq) + dTap[n];
+              }
+              if (rsq >= cut_ljsq) {
+                taper = 0.0;
+                dtaper = 0.0;
+              }
+            }
+            else {
+              taper = 1.0;
+              dtaper = 0.0;
+            }
+  
+            // UNB Part
+            R = R_UNB[itype][jtype];
+            D = D_UNB[itype][jtype];
+            L = L_UNB[itype][jtype];
+  
+            r = (sqrt(rsq) - R) / L;
+            r2 = r * r;
+            r3 = r2 * r;
+            r4 = r3 * r;
+            r5 = r4 * r;
+  
+            exp1 = -D * exp(-beta * r);
+            exp2 = s0 + s1 * r + s2 * r2 + s3 * r3 + s4 * r4 + s5 * r5;
+            e_vdW = exp1 * exp2;
+  
+            dexp1 = -beta * exp1 / L;
+            dexp2 = (s1 + 2.0 * s2 * r + 3.0 * s3 * r2 + 4.0 * s4 * r3 + 5.0 * s5 * r4) / L;
+            de_vdW = (dexp1 * exp2 + exp1 * dexp2);
+  
+            evdwl = factor_lj * taper  * e_vdW;
+          } else evdwl = 0.0;
+        }
+
+        if (evflag) ev_tally(i,j,nlocal,newton_pair,
+                             evdwl,ecoul,fpair,delx,dely,delz);
+      }
+    }
+  }
+
+  if (vflag_fdotr) virial_fdotr_compute();
+}
+
+/* ----------------------------------------------------------------------
+   allocate all arrays
+------------------------------------------------------------------------- */
+
+void PairUNBCoulCut::allocate()
+{
+  allocated = 1;
+  int n = atom->ntypes;
+
+  memory->create(setflag,n+1,n+1,"pair:setflag");
+  for (int i = 1; i <= n; i++) {
+    for (int j = i; j <= n; j++) {
+      setflag[i][j] = 0;
+    }
+  }
+
+  // UNB Part
+  memory->create(R_UNB,n+1,n+1,"pair:R_UNB");
+  memory->create(D_UNB,n+1,n+1,"pair:D_UNB");
+  memory->create(L_UNB,n+1,n+1,"pair:L_UNB");
+
+  memory->create(cutsq, n+1, n+1, "pair:cutsq");
+  memory->create(cut, n+1, n+1, "pair:cut");
+}
+
+/* ----------------------------------------------------------------------
+   global settings
+   unlike other pair styles,
+     there are no individual pair settings that these override
+------------------------------------------------------------------------- */
+
+void PairUNBCoulCut::settings(int narg, char **arg)
+{
+  if ((narg < 1) || (narg > 4))
+    error->all(FLERR,"Illegal pair_style command");
+
+  swa = 0.0;
+  cut_lj = utils::numeric(FLERR,arg[0],false,lmp);
+
+  // default values
+  cut_coul = cut_lj;
+  taper_flag = 1;
+
+  if (narg == 2) {
+    cut_coul = utils::numeric(FLERR,arg[1],false,lmp);
+  }
+  else if (narg == 3) {
+    cut_coul = utils::numeric(FLERR,arg[1],false,lmp);
+    taper_flag = utils::inumeric(FLERR,arg[2],false,lmp);
+  }
+
+  // reset cutoffs that have been explicitly set
+
+  if (allocated) {
+    int i, j;
+    for (i = 1; i <= atom->ntypes; i++)
+      for (j = i; j <= atom->ntypes; j++)
+        if (setflag[i][j]) cut[i][j] = cut_coul;
+  }
+}
+
+/* ----------------------------------------------------------------------
+   set coeffs for one or more type pairs
+------------------------------------------------------------------------- */
+
+void PairUNBCoulCut::coeff(int narg, char **arg)
+{
+  if ((narg < 5) || (narg > 6)) error->all(FLERR,"Illegal pair_coeff command");
+  if (!allocated) allocate();
+
+  int ilo,ihi,jlo,jhi;
+  utils::bounds(FLERR,arg[0],1,atom->ntypes,ilo,ihi,error);
+  utils::bounds(FLERR,arg[1],1,atom->ntypes,jlo,jhi,error);
+
+  // UNB Part
+  double R_one = utils::numeric(FLERR,arg[2],false,lmp);
+  double D_one = utils::numeric(FLERR,arg[3],false,lmp);
+  double L_one = utils::numeric(FLERR,arg[4],false,lmp);
+  
+  double cut_one = cut_coul;
+  if (narg == 6) cut_one = utils::numeric(FLERR, arg[5], false, lmp);
+
+  int count = 0;
+  for (int i = ilo; i <= ihi; i++) {
+    for (int j = MAX(jlo,i); j <= jhi; j++) {
+      // UNB Part, allow off-diagonal
+      R_UNB[i][j] = R_one;
+      D_UNB[i][j] = D_one;
+      L_UNB[i][j] = L_one;
+      R_UNB[j][i] = R_one;
+      D_UNB[j][i] = D_one;
+      L_UNB[j][i] = L_one;
+      cut[i][j] = cut_one;
+      setflag[i][j] = 1;
+      count++;
+    }
+  }
+
+  if (count == 0) error->all(FLERR,"Incorrect args for pair coefficients");
+}
+
+/* ----------------------------------------------------------------------
+   init specific to this pair style
+------------------------------------------------------------------------- */
+
+void PairUNBCoulCut::init_style()
+{
+  if (!atom->q_flag)
+    error->all(FLERR,
+               "Pair style unb/coul/long requires atom attribute q");
+
+  neighbor->add_request(this);
+
+  cut_ljsq = cut_lj * cut_lj;
+  cut_coulsq = cut_coul * cut_coul;
+  cut_bothsq = MAX(cut_ljsq,cut_coulsq);
+
+  swb = cut_lj;
+  swa2 = swa * swa;
+  swb2 = swb * swb;
+  swb3 = swb2 * swb;
+  swa3 = swa2 * swa;
+
+  // Global Parameters for UNB, J. Chem. Phys. 151, 154111 (2019)
+  beta = 1.0035;
+  s0 = 1.0000;
+  s1 = 1.0201;
+  s2 = 0.0168;
+  s3 = 0.0033;
+  s4 = 0.0037;
+  s5 = 0.0011;
+
+  init_taper();      
+
+}
+
+/* ----------------------------------------------------------------------
+   init for one type pair i,j and corresponding j,i
+------------------------------------------------------------------------- */
+
+double PairUNBCoulCut::init_one(int i, int j)
+{
+  // UNB Part
+  if (setflag[i][j] == 0) {// Geometric Mean is used when off-diagonal terms are undefined
+    R_UNB[i][j] = sqrt(R_UNB[i][i] * R_UNB[j][j]);
+    D_UNB[i][j] = sqrt(D_UNB[i][i] * D_UNB[j][j]);
+    L_UNB[i][j] = sqrt(L_UNB[i][i] * L_UNB[j][j]);
+    R_UNB[j][i] = sqrt(R_UNB[i][i] * R_UNB[j][j]);
+    D_UNB[j][i] = sqrt(D_UNB[i][i] * D_UNB[j][j]);
+    L_UNB[j][i] = sqrt(L_UNB[i][i] * L_UNB[j][j]);
+
+    cut[i][j] = mix_distance(cut[i][i], cut[j][j]);
+  }
+
+  return cut[i][j];
+}
+
+/* ----------------------------------------------------------------------
+   proc 0 writes to data file
+------------------------------------------------------------------------- */
+
+void PairUNBCoulCut::write_data(FILE *fp)
+{
+  for (int i = 1; i <= atom->ntypes; i++)
+    fprintf(fp,"%d %g %g %g\n",
+            i,R_UNB[i][i],D_UNB[i][i],L_UNB[i][i]);
+}
+
+/* ----------------------------------------------------------------------
+   proc 0 writes all pairs to data file
+------------------------------------------------------------------------- */
+
+void PairUNBCoulCut::write_data_all(FILE *fp)
+{
+  for (int i = 1; i <= atom->ntypes; i++)
+    for (int j = i; j <= atom->ntypes; j++)
+      fprintf(fp,"%d %d %g %g %g\n",i,j,
+              R_UNB[i][j],D_UNB[i][j],L_UNB[i][j]);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void *PairUNBCoulCut::extract(const char *str, int &dim)
+{
+  dim = 2;
+  if (strcmp(str,"R_UNB") == 0) return (void *) R_UNB;
+  if (strcmp(str,"D_UNB") == 0) return (void *) D_UNB;
+  if (strcmp(str,"L_UNB") == 0) return (void *) L_UNB;
+
+  dim = 0;
+  if (strcmp(str,"implicit") == 0) return (void *) &implicit;
+  if (strcmp(str,"cut_coul") == 0) return (void *) &cut_coul;
+
+  return nullptr;
+}
+
+
+/* -----------------------------------------------------------------------
+   Intializes the taper, as in fix_qeq_reax
+ -------------------------------------------------------------------------- */
+
+void PairUNBCoulCut::init_taper()
+{
+  double d7, swa2, swa3, swb2, swb3;
+
+  // Taper for UNB
+  if (swb < 0)
+    error->all(FLERR, "PairUNBCoulPqeqgauss has negative upper Taper radius cutoff for Coulomb");
+
+  d7 = pow( swb - swa, 7 );
+  swa2 = SQR( swa );
+  swa3 = CUBE( swa );
+  swb2 = SQR( swb );
+  swb3 = CUBE( swb );
+
+  Tap[7] =  20.0 / d7;
+  Tap[6] = -70.0 * (swa + swb) / d7;
+  Tap[5] =  84.0 * (swa2 + 3.0*swa*swb + swb2) / d7;
+  Tap[4] = -35.0 * (swa3 + 9.0*swa2*swb + 9.0*swa*swb2 + swb3 ) / d7;
+  Tap[3] = 140.0 * (swa3*swb + 3.0*swa2*swb2 + swa*swb3 ) / d7;
+  Tap[2] =-210.0 * (swa3*swb2 + swa2*swb3) / d7;
+  Tap[1] = 140.0 * swa3 * swb3 / d7;
+  Tap[0] = (-35.0*swa3*swb2*swb2 + 21.0*swa2*swb3*swb2 +
+            7.0*swa*swb3*swb3 + swb3*swb3*swb ) / d7;
+
+  //taper derivative
+  dTap[7] = 0.0;
+  dTap[6] = 7.0*Tap[7];
+  dTap[5] = 6.0*Tap[6];
+  dTap[4] = 5.0*Tap[5];
+  dTap[3] = 4.0*Tap[4];
+  dTap[2] = 3.0*Tap[3];
+  dTap[1] = 2.0*Tap[2];
+  dTap[0] = Tap[1];
+}
