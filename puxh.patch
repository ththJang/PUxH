+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::setup_pre_force(int vflag)
+{
+  nn = list->inum;
+  ilist = list->ilist;
+  numneigh = list->numneigh;
+  firstneigh = list->firstneigh;
+
+  deallocate_storage();
+  allocate_storage();
+
+  init_storage();
+
+  deallocate_matrix();
+  allocate_matrix();
+
+  pre_force(vflag);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::setup_pre_force_respa(int vflag, int ilevel)
+{
+  if (ilevel < nlevels_respa-1) return;
+  setup_pre_force(vflag);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::min_setup_pre_force(int vflag)
+{
+  setup_pre_force(vflag);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::init_storage()
+{
+  qforce();
+
+
+  for (int ii = 0; ii < nn; ii++) {
+    int i = ilist[ii];
+    if (atom->mask[i] & groupbit) {
+      Hdia_inv[i] = 1. / idem[atom->type[i]];
+      b_s[i] = -chi[atom->type[i]] + EV_TO_KCAL_PER_MOL * qf[i];
+      b_t[i] = -1.0;
+      b_prc[i] = 0;
+      b_prm[i] = 0;
+      s[i] = t[i] = 0;
+    }
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::pre_force(int /*vflag*/)
+{
+  int i,j,method; //0 for Only QEq, 1 for Only Shell, 2 for Full PQEq
+
+  if (nevery == 0 && nshellevery == 0) return; //0 means that we do not calculate
+  else if (nevery != 0 && nshellevery == 0) {
+    method = 0;//Only QEq
+    if(update->ntimestep % nevery) return;
+  }
+  else if (nevery == 0 && nshellevery != 0) {
+    method = 1;//Only Shell
+    if(update->ntimestep % nshellevery) return;
+  }
+  else {
+    method = 2;//Full PQEq
+    if((update->ntimestep % nevery) && !(update->ntimestep % nshellevery)) method = 1;
+    else if(!(update->ntimestep % nevery) && (update->ntimestep % nshellevery)) method = 0;
+    else if((update->ntimestep % nevery) && (update->ntimestep % nshellevery)) return;
+  }
+
+  int n = atom->nlocal;
+
+  nn = list->inum;
+  ilist = list->ilist;
+  numneigh = list->numneigh;
+  firstneigh = list->firstneigh;
+
+  // grow arrays if necessary
+  // need to be atom->nmax in length
+  if (atom->nmax > nmax) reallocate_storage();
+  if (n > n_cap*DANGER_ZONE || m_fill > m_cap*DANGER_ZONE)
+    reallocate_matrix();
+
+  if (method == 0) {
+    cqf = 0.0;
+    for ( j = 0; j < Hiter + 1; j++ ) {
+      if (Hiter != 0) set_Hydrogen();
+      init_matvec();
+      matvecs = CG(b_s, s);
+      matvecs += CG(b_t, t);
+      calculate_Q();
+    }
+  }
+  else if (method == 1) {
+    if (Hiter != 0) set_Hydrogen();
+    sforce();
+    calculate_Shell();
+  }
+  else if (method == 2) {
+    cqf = 1.0; 
+    for( i = 0; i < ncycle; i++ ) {
+      for ( j = 0; j < Hiter + 1; j++ ) {
+        if (Hiter != 0) set_Hydrogen();
+        qforce();
+        init_matvec();
+        matvecs = CG(b_s, s);         
+        matvecs += CG(b_t, t);        
+        calculate_Q();
+      }
+      sforce();               
+      calculate_Shell();
+    }
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::pre_force_respa(int vflag, int ilevel, int /*iloop*/)
+{
+  if (ilevel == nlevels_respa-1) pre_force(vflag);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::min_pre_force(int vflag)
+{
+  pre_force(vflag);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::init_matvec()
+{
+  /* fill-in H matrix */
+  compute_H();
+
+  int ii, i;
+
+  for (ii = 0; ii < nn; ++ii) {
+    i = ilist[ii];
+    if (atom->mask[i] & groupbit) {
+
+      /* init pre-conditioner for H and init solution vectors */
+      if (Hiter) Hdia_inv[i] = 1. / idem[atom->type[i]] / J_coeff[i];
+      else Hdia_inv[i] = 1. / idem[atom->type[i]];
+      b_s[i]      = -chi[atom->type[i]] + cqf * EV_TO_KCAL_PER_MOL * qf[i];
+      b_t[i]      = -1.0;
+
+      /* quadratic extrapolation for s & t from previous solutions */
+      t[i] = t_hist[i][2] + 3 * (t_hist[i][0] - t_hist[i][1]);
+
+      /* cubic extrapolation for s & t from previous solutions */
+      s[i] = 4*(s_hist[i][0]+s_hist[i][2])-(6*s_hist[i][1]+s_hist[i][3]);
+    }
+  }
+
+  pack_flag = 2;
+  comm->forward_comm(this); //Dist_vector(s);
+  pack_flag = 3;
+  comm->forward_comm(this); //Dist_vector(t);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::compute_H()
+{
+  int jnum;
+  int i, j, ii, jj, flag;
+  double dx, dy, dz, r_sqr;
+  constexpr double EPSILON = 0.0001;
+
+  int *type = atom->type;
+  tagint *tag = atom->tag;
+  double **x = atom->x;
+  int *mask = atom->mask;
+
+  double lambda = 0.462770;
+  double alpha_ci, alpha_cj, alpha_cc;
+
+  // fill in the H matrix
+  m_fill = 0;
+  r_sqr = 0;
+  for (ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (mask[i] & groupbit) {
+      jlist = firstneigh[i];
+      jnum = numneigh[i];
+      H.firstnbr[i] = m_fill;
+
+      for (jj = 0; jj < jnum; jj++) {
+        j = jlist[jj];
+        j &= NEIGHMASK;
+
+        dx = x[j][0] - x[i][0];
+        dy = x[j][1] - x[i][1];
+        dz = x[j][2] - x[i][2];
+        r_sqr = SQR(dx) + SQR(dy) + SQR(dz);
+
+        flag = 0;
+        if (r_sqr <= SQR(swb)) {
+          if (j < atom->nlocal) flag = 1;
+          else if (tag[i] < tag[j]) flag = 1;
+          else if (tag[i] == tag[j]) {
+            if (dz > EPSILON) flag = 1;
+            else if (fabs(dz) < EPSILON) {
+              if (dy > EPSILON) flag = 1;
+              else if (fabs(dy) < EPSILON && dx > EPSILON)
+                flag = 1;
+            }
+          }
+        }
+        if (flag) {
+          H.jlist[m_fill] = j;
+          if (Hiter) {//Re-calculate the alpha based on new H radius
+            alpha_ci = Alpha_coeff[i] * lambda * 0.5 / rcore[type[i]] / rcore[type[i]];
+            alpha_cj = Alpha_coeff[j] * lambda * 0.5 / rcore[type[j]] / rcore[type[j]];
+            alpha_cc = sqrt(alpha_ci*alpha_cj/(alpha_ci+alpha_cj));
+            H.val[m_fill] = calculate_H(sqrt(r_sqr), alpha_cc);
+          }
+          else H.val[m_fill] = calculate_H(sqrt(r_sqr), alphacc[type[i]][type[j]]);
+          m_fill++;
+        }
+      }
+      H.numnbrs[i] = m_fill - H.firstnbr[i];
+    }
+  }
+
+  if (m_fill >= H.m)
+    error->all(FLERR,fmt::format("Fix pqeq H matrix size has been "
+                                 "exceeded: m_fill={} H.m={}\n", m_fill, H.m));
+}
+
+/* ---------------------------------------------------------------------- */
+
+double FixPQEq::calculate_H(double r, double alphacc)
+{
+  double Taper, coul;
+
+  if ((r > swa) && taper_flag) {
+    Taper  =  Tap[7];
+    for(int n=6; n>=0; n--){
+      Taper  = Taper * r + Tap[n];
+    }
+  } else Taper = 1.0;
+
+  coul = erf(alphacc * r) / r;
+
+  return Taper * EV_TO_KCAL_PER_MOL * coul;
+}
+
+/* ---------------------------------------------------------------------- */
+
+int FixPQEq::CG(double *b, double *x)
+{
+  int  i, j;
+  double tmp, alpha, beta, b_norm;
+  double sig_old, sig_new;
+
+  int jj;
+
+  imax = numCG;
+
+  pack_flag = 1;
+  sparse_matvec(&H, x, q);
+  comm->reverse_comm(this); //Coll_Vector(q);
+
+  vector_sum(r , 1.,  b, -1., q, nn);
+
+  for (jj = 0; jj < nn; ++jj) {
+    j = ilist[jj];
+    if (atom->mask[j] & groupbit)
+      d[j] = r[j] * Hdia_inv[j]; //pre-condition
+  }
+
+  b_norm = parallel_norm(b, nn);
+  sig_new = parallel_dot(r, d, nn);
+
+  for (i = 1; i < imax && sqrt(sig_new) / b_norm > tolerance; ++i) {
+    comm->forward_comm(this); //Dist_vector(d);
+    sparse_matvec(&H, d, q);
+    comm->reverse_comm(this); //Coll_vector(q);
+
+    tmp = parallel_dot(d, q, nn);
+    alpha = sig_new / tmp;
+
+    vector_add(x, alpha, d, nn);
+    vector_add(r, -alpha, q, nn);
+
+    // pre-conditioning
+    for (jj = 0; jj < nn; ++jj) {
+      j = ilist[jj];
+      if (atom->mask[j] & groupbit)
+        p[j] = r[j] * Hdia_inv[j];
+    }
+
+    sig_old = sig_new;
+    sig_new = parallel_dot(r, p, nn);
+
+    beta = sig_new / sig_old;
+    vector_sum(d, 1., p, beta, d, nn);
+  }
+
+  if ((i >= imax) && maxwarn && (comm->me == 0))
+    error->warning(FLERR,fmt::format("Fix pqeq CG convergence failed "
+                                     "after {} iterations at step {}",
+                                     i,update->ntimestep));
+  return i;
+}
+
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::sparse_matvec(sparse_matrix *A, double *x, double *b)
+{
+  int i, j, itr_j;
+  int ii;
+
+  for (ii = 0; ii < nn; ++ii) {
+    i = ilist[ii];
+    if (atom->mask[i] & groupbit)
+      b[i] = idem[atom->type[i]] * x[i];
+  }
+
+  int nall = atom->nlocal + atom->nghost;
+  for (i = atom->nlocal; i < nall; ++i)
+      b[i] = 0;
+
+  for (ii = 0; ii < nn; ++ii) {
+    i = ilist[ii];
+    if (atom->mask[i] & groupbit) {
+      for (itr_j=A->firstnbr[i]; itr_j<A->firstnbr[i]+A->numnbrs[i]; itr_j++) {
+        j = A->jlist[itr_j];
+        b[i] += A->val[itr_j] * x[j];
+        b[j] += A->val[itr_j] * x[i];
+      }
+    }
+  }
+
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::calculate_Q()
+{
+  int i, k;
+  double u, s_sum, t_sum;
+  double q_new, q_old;
+  double *q = atom->q;
+
+  int ii;
+
+  s_sum = parallel_vector_acc(s, nn);
+  t_sum = parallel_vector_acc(t, nn);
+  u = (s_sum - netchg) / t_sum;
+
+  for (ii = 0; ii < nn; ++ii) {
+    i = ilist[ii];
+    if (atom->mask[i] & groupbit) {
+        q_old = q[i];
+        q_new = s[i] - u * t[i];
+        q[i] = damp*q_new + (1.0-damp)*q_old; 
+      /* backup s & t */
+      for (k = nprev-1; k > 0; --k) {
+        s_hist[i][k] = s_hist[i][k-1];
+        t_hist[i][k] = t_hist[i][k-1];
+      }
+      s_hist[i][0] = s[i];
+      t_hist[i][0] = t[i];
+    }
+  }
+
+  pack_flag = 4;
+  comm->forward_comm(this); //Dist_vector(atom->q);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::calculate_Shell()
+{
+  double **rsx = atom->rsx;
+  int *type = atom->type;
+  double k2,k4,r0,r1,r_new,r_old,delx,dely,delz;
+  double rfx,rfy,rfz,rf;
+  double rsx_old[3], rsx_new[3], rsq;
+
+  int i, j, itype;
+  int *mask = atom->mask;
+  
+  int nlocal = atom->nlocal;
+
+  for (i = 0; i < nlocal; i++) {
+    if (mask[i] & groupbit) {
+      itype = type[i];
+      if (polar[itype]) {
+        if (Hiter) k2 = K2_coeff[i] * kstring2[itype];
+        else k2 = kstring2[itype];// 1/2 k2 r^2
+        k4 = kstring4[itype];// k4 r^4
+        rfx = sf[i][0]; rfy = sf[i][1]; rfz = sf[i][2];
+        rf = sqrt(rfx*rfx + rfy*rfy + rfz*rfz);
+        //current position of the shell
+        //delx = rsx[i][0]; dely = rsx[i][1]; delz = rsx[i][2];
+        //r_old = sqrt(delx*delx + dely*dely + delz*delz);
+        // calculate shell dist from the core using Newton-Raphson
+        // Newton-Raphson interation is determined by nshelliter from input
+        // During iteration, F_ext is fixed.
+      
+        for (j = 0; j < nshelliter; j++) {
+          if (j == 0) {
+            rsx_old[0] = rsx[i][0];
+            rsx_old[1] = rsx[i][1];
+            rsx_old[2] = rsx[i][2];
+          }
+          else {
+            rsx_old[0] = rsx_new[0];
+            rsx_old[1] = rsx_new[1];
+            rsx_old[2] = rsx_new[2];
+          }
+          rsq = rsx_old[0] * rsx_old[0] + rsx_old[1] * rsx_old[1] + rsx_old[2] * rsx_old[2];
+
+          if (rf > 1.e-10) {
+             // when use k4 term, single newon-Rapson is not enough to go zero force limit
+             rsx_new[0] = rsx_old[0] * (8.0 * k4 * rsq) / (k2 + 12.0 * k4 * rsq) + rfx / (k2 + 12.0 * k4 * rsq);
+             rsx_new[1] = rsx_old[1] * (8.0 * k4 * rsq) / (k2 + 12.0 * k4 * rsq) + rfy / (k2 + 12.0 * k4 * rsq);
+             rsx_new[2] = rsx_old[2] * (8.0 * k4 * rsq) / (k2 + 12.0 * k4 * rsq) + rfz / (k2 + 12.0 * k4 * rsq);
+          } else {
+             rsx_new[0] = 0.0;
+             rsx_new[1] = 0.0;
+             rsx_new[2] = 0.0;
+          }
+        }
+        if ((rsx_new[0] > 0.25) || (rsx_new[1] > 0.25) || (rsx_new[2] > 0.25)) error->warning(FLERR,"Warning: core-shell dist more than 0.250 A");
+
+        rsx[i][0] = damp * rsx_new[0] + (1.0 - damp) * rsx_old[0];
+        rsx[i][1] = damp * rsx_new[1] + (1.0 - damp) * rsx_old[1];
+        rsx[i][2] = damp * rsx_new[2] + (1.0 - damp) * rsx_old[2];
+      }
+    }
+  }
+
+  pack_flag = 5;
+  comm->forward_comm(this);
+}
