+int FixPSQ::pack_forward_comm(int n, int *list, double *buf,
+                               int pbc_flag, int *pbc) {
+  int i, j, m;
+
+  m = 0;
+
+  if (pack_flag == 1)
+    for (i = 0; i < n; i++) {
+      j = list[i];
+      buf[m++] = d[j];
+    }
+  else if (pack_flag == 2)
+    for (i = 0; i < n; i++) {
+      j = list[i];
+      buf[m++] = s[j];
+    }
+  else if (pack_flag == 3)
+    for (i = 0; i < n; i++) {
+      j = list[i];
+      buf[m++] = t[j];
+    }
+  else if (pack_flag == 4)
+    for (i = 0; i < n; i++) {
+      j = list[i];
+      buf[m++] = atom->q[j];
+    }
+  else if (pack_flag == 5)
+    for (i = 0; i < n; i++) {
+      j = list[i];
+      buf[m++] = atom->rsx[j][0];
+      buf[m++] = atom->rsx[j][1];
+      buf[m++] = atom->rsx[j][2];
+    }
+  else if (pack_flag == 6)
+    for (i = 0; i < n; i++) {
+      j = list[i];
+      buf[m++] = qf[j];
+    }
+  else if (pack_flag == 8)
+    for (i = 0; i < n; i++) {
+      j = list[i];
+      buf[m++] = sf[j][0];
+      buf[m++] = sf[j][1];
+      buf[m++] = sf[j][2];
+    }
+  //  else if (pack_flag == 10)
+  //    for (i = 0; i < n; i++) {
+  //      j = list[i];
+  //      buf[m++] = qifj[j];
+  //    }
+
+  return m;
+}
