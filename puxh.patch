+/* ---------------------------------------------------------------------- */
+
+FixReaxFFRexPoNBonds::FixReaxFFRexPoNBonds(LAMMPS *lmp, int narg, char **arg) :
+  Fix(lmp, narg, arg)
+{
+  if (narg != 5) error->all(FLERR,"Illegal fix reaxff/rexpon/bonds command");
+
+  MPI_Comm_rank(world,&me);
+  MPI_Comm_size(world,&nprocs);
+  ntypes = atom->ntypes;
+  nmax = atom->nmax;
+  compressed = 0;
+
+  nevery = utils::inumeric(FLERR,arg[3],false,lmp);
+
+  if (nevery <= 0) error->all(FLERR,"Illegal fix reaxff/rexpon/bonds command");
+
+  if (me == 0) {
+    if (platform::has_compress_extension(arg[4])) {
+      compressed = 1;
+      fp = platform::compressed_write(arg[4]);
+      if (!fp) error->one(FLERR,"Cannot open compressed file");
+    } else fp = fopen(arg[4],"w");
+
+    if (!fp) error->one(FLERR,fmt::format("Cannot open fix reaxff/rexpon/bonds file {}: {}",
+                                          arg[4],utils::getsyserror()));
+  }
+
+  if (atom->tag_consecutive() == 0)
+    error->all(FLERR,"Atom IDs must be consecutive for fix reaxff/rexpon bonds");
+
+  abo = nullptr;
+  neighid = nullptr;
+  numneigh = nullptr;
+
+  allocate();
+}
+
+/* ---------------------------------------------------------------------- */
+
+FixReaxFFRexPoNBonds::~FixReaxFFRexPoNBonds()
+{
+  MPI_Comm_rank(world,&me);
+
+  destroy();
+
+  if (me == 0) fclose(fp);
+}
+
+/* ---------------------------------------------------------------------- */
+
+int FixReaxFFRexPoNBonds::setmask()
+{
+  int mask = 0;
+  mask |= END_OF_STEP;
+  return mask;
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixReaxFFRexPoNBonds::setup(int /*vflag*/)
+{
+  end_of_step();
+}
+
+/* ---------------------------------------------------------------------- */
+
+void FixReaxFFRexPoNBonds::init()
+{
+  reaxff_rexpon = dynamic_cast<PairReaxFFRexPoN *>( force->pair_match("^reax..",0));
+  if (reaxff_rexpon == nullptr) error->all(FLERR,"Cannot use fix reaxff/rexpon/bonds without "
+                                "pair_style reaxff/rexpon, reaxff/rexpon/kk, or reaxff/rexpon/omp");//kk & omp is not implemented on ReaxFF/RexPoN
+}
