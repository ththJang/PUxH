+
+void FixPQEq::unpack_forward_comm(int n, int first, double *buf)
+{
+  int i, m, last;
+  
+  m = 0;
+  last = first + n ;
+
+  if( pack_flag == 1) {
+    for (i = first; i < last; i++) {
+      d[i] = buf[m++];
+    } 
+  }
+  else if( pack_flag == 2) {
+    for (i = first; i < last; i++) {
+      s[i] = buf[m++];
+    }
+  }
+  else if( pack_flag == 3) {
+    for (i = first; i < last; i++) {
+      t[i] = buf[m++];
+    }
+  }
+  else if( pack_flag == 4) {
+    for (i = first; i < last; i++) {
+      atom->q[i] = buf[m++];
+    }
+  }
+  else if( pack_flag == 5) {
+    for (i = first; i < last; i++) {
+      atom->rsx[i][0] = buf[m++];
+      atom->rsx[i][1] = buf[m++];
+      atom->rsx[i][2] = buf[m++];
+    }
+  }
+  else if( pack_flag == 6) {
+    for (i = first; i < last; i++) {
+      qf[i] = buf[m++];
+    }
+  }
+  else if( pack_flag == 8) {
+    for (i = first; i < last; i++) {
+      sf[i][0] = buf[m++];
+      sf[i][1] = buf[m++];
+      sf[i][2] = buf[m++];
+    }
+  }
+}
