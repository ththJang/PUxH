+/* ---------------------------------------------------------------------- */
+
+void FixPSQ::init_matvec() {
+  int NN;
+  int nn;
+  int i, j, k, l;
+  int ii, jj;
+  double chi_i, idem_i;
+  double qf_i, qf_j;
+  double qfcc_i, qfcc_j;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  tagint *tag = atom->tag;
+  tagint **bond_atom = atom->bond_atom;
+  natoms = atom->natoms;
+  int ndim = natoms + 1;
+  nn = list->inum;
+  NN = list->inum + list->gnum;
+  int jnum, itag, jtag;
+  int nlocal = atom->nlocal;
+  int newton_pair = force->newton_pair;
+  int *mask = atom->mask;
+  double tempchi;
+  int nbonds1, nbonds2;
+
+  vector_renew(Vcis_local, 1);
+  vector_CRS_renew(chis_core, n_nz);
+  qforce();
+
+  if (efield) get_chi_field();
+	int cnt;
+  ilist = list->ilist;
+  firstneigh = list->firstneigh;
+  numneigh = list->numneigh;
+  for (int ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    itag = tag[i];              
+    chi_i = chi[atom->type[i]]; 
+    idem_i = idem[atom->type[i]];
+    qfcc_i = qfcc[itag];
+    nbonds1 = atom->num_bond[i];
+    nbonds2 = counter_num_bond[itag];
+    cnt = row_ptr[itag - 1];
+    for (jj = 0; jj < nbonds1; jj++) {
+      j = bond_atom[i][jj];
+      qfcc_j = qfcc[j];
+      chis_core[cnt] = -(chi_i + idem_i * iniq[atom->type[i]] - chi[atom->type[atom->map(j)]] - idem[atom->type[atom->map(j)]] * iniq[atom->type[atom->map(j)]]) + (qfcc_i  - qfcc_j) * EV_TO_KCAL_PER_MOL;
+      if (efield) chis_core[cnt] -= (chi_field[itag] - chi_field[j]);
+      cnt++;
+    }
+    for (jj = 0; jj < nbonds2; jj++) {
+      j = counter_bond_atom[itag][jj];
+      qfcc_j = qfcc[j];
+      chis_core[cnt] = -(chi_i + idem_i * iniq[atom->type[i]] - chi[atom->type[atom->map(j)]] - idem[atom->type[atom->map(j)]] * iniq[atom->type[atom->map(j)]]) + (qfcc_i - qfcc_j) * EV_TO_KCAL_PER_MOL;
+      if (efield) chis_core[cnt] -= (chi_field[itag] - chi_field[j]);
+      cnt++;
+    }
+  }
+
+}
