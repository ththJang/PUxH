+#ifdef PAIR_CLASS
+// clang-format off
+PairStyle(sw/angle,PairSWAngle);
+// clang-format on
+#else
+
+#ifndef LMP_PAIR_SW_ANGLE_H
+#define LMP_PAIR_SW_ANGLE_H
+
+#include "pair.h"
+
+namespace LAMMPS_NS {
+
+class PairSWAngle : public Pair {
+ public:
+  PairSWAngle(class LAMMPS *);
+  ~PairSWAngle() override;
+  void compute(int, int) override;
+  void coeff(int, char **) override;
+  double init_one(int, int) override;
+  void init_style() override;
+
+  static constexpr int NPARAMS_PER_LINE = 12;
+
+  struct Param {
+    double tol;
+    double cut, cutsq;
+    double c1, c2, c3, c4, c5, c6;
+    int ielement, jelement, kelement;
+
+    // New r equation from RexPoN
+    double pbo1, pbo2, Re, a, b, C, theta, costheta;
+  };
+
+ protected:
+  double cutmax;      // max cutoff for all elements
+  Param *params;      // parameter set for an I-J-K interaction
+  int maxshort;       // size of short neighbor list array
+  int *neighshort;    // short neighbor list array
+
+  int inner_flag;     // 1: Calculate also theta < theta_eq; 0: Only calculate theta > theta_eq
+
+  void settings(int, char **) override;
+  virtual void allocate();
+  virtual void read_file(char *);
+  virtual void setup_params();
+  virtual void threebody(Param *, Param *, Param *, double, double, double *, double *, double *,
+                         double *, int, double &);
+};
+
+}    // namespace LAMMPS_NS
+
+#endif
+#endif
