+
+namespace LAMMPS_NS {
+
+class PairUNBCoulLong : public Pair {
+ public:
+  PairUNBCoulLong(class LAMMPS *);
+  ~PairUNBCoulLong() override;
+
+  void compute(int, int) override;
+  void settings(int, char **) override;
+  void coeff(int, char **) override;
+  void init_style() override;
+  double init_one(int, int) override;
+  void write_data(FILE *) override;
+  void write_data_all(FILE *) override;
+
+  void *extract(const char *, int &) override;
+
+  // parameters of the UNB
+  double **R_UNB;
+  double **D_UNB;
+  double **L_UNB;
+
+ protected:
+  int implicit;
+  double cut_lj;
+  double cut_ljsq;
+  double cut_coul, cut_coulsq;
+  double cut_bothsq;
+  double g_ewald;
+
+  // Global paremters of the UNB
+  double beta,s0,s1,s2,s3,s4,s5;
+
+  // cut offs for the taper
+  double swa,swb;   // read on the input
+  double swa2,swb2,swa3,swb3;
+  int taper_flag;
+  // taper coefficients
+  double Tap_unb[8];
+  double dTap_unb[8];
+  double Tap[8];
+  double dTap[8];
+
+  void init_taper();
+
+  virtual void allocate();
+};
