+/* ---------------------------------------------------------------------- */
+
+double BondTable::single(int type, double rsq, int /*i*/, int /*j*/, double &fforce)
+{
+  double r = sqrt(rsq);
+  double u;
+  double mdu;
+  uf_lookup(type, r, u, mdu);
+  fforce = mdu / r;
+  return u;
+}
