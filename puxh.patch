+    //printf("after %d\t%d\n",rank,tag_i);
+    api->system->my_atoms[tag_i].num_bonds_classic=temp;
+      //MPI_Bcast(&api->system->my_atoms[tag_i].num_bonds_classic,1,MPI_INT,0,world);
+      //printf("%d\t%d\t%d\n",rank,tag_i,api->system->my_atoms[tag_i].num_bonds_classic);
+      for (m = 0; m < api->system->my_atoms[tag_i].num_bonds_classic; m++) {
