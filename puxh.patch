+/* ---------------------------------------------------------------------- */
+
+ComputeSpecAtomRexPoN::~ComputeSpecAtomRexPoN()
+{
+  delete [] pack_choice;
+  memory->destroy(vector);
+  memory->destroy(array);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ComputeSpecAtomRexPoN::compute_peratom()
+{
+  invoked_peratom = update->ntimestep;
+
+  // grow vector or array if necessary
+
+  if (atom->nmax > nmax) {
+    nmax = atom->nmax;
+    if (nvalues == 1) {
+      memory->destroy(vector);
+      memory->create(vector,nmax,"property/atom:vector");
+      vector_atom = vector;
+    } else {
+      memory->destroy(array);
+      memory->create(array,nmax,nvalues,"property/atom:array");
+      array_atom = array;
+    }
+  }
+
+  // fill vector or array with per-atom values
+
+  if (nvalues == 1) {
+    buf = vector;
+    (this->*pack_choice[0])(0);
+  } else {
+    if (nmax > 0) {
+      buf = &array[0][0];
+      for (int n = 0; n < nvalues; n++)
+        (this->*pack_choice[n])(n);
+    }
+  }
+}
+
+/* ----------------------------------------------------------------------
+   memory usage of local atom-based array
+------------------------------------------------------------------------- */
+
+double ComputeSpecAtomRexPoN::memory_usage()
+{
+  double bytes = (double)nmax*nvalues * sizeof(double);
+  return bytes;
+}
