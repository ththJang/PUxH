+/* ---------------------------------------------------------------------- */
+
+void BondGromos::compute(int eflag, int vflag)
+{
+  int i1, i2, n, type;
+  double delx, dely, delz, ebond, fbond;
+
+  ebond = 0.0;
+  ev_init(eflag, vflag);
+
+  double **x = atom->x;
