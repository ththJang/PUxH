+
+void FixPSQ::setup_pre_force(int vflag) {
+  // neighbor->build_one(list);
+
+  deallocate_storage();
+  allocate_storage();
+  int ndim = atom->natoms + 1;
+  vector_renew(qifj, ndim);
+  vector_renew(qifj_local, ndim);
+  vector_renew(khs_local, ndim);
+
+  for (int i = 0; i < ndim; i++) {
+    counter_num_bond[i] = counter_num_bond_local[i] = 0;
+    global_num_bond[i] = global_num_bond_local[i] = 0;
+    for (int j = 0; j < 8; j++) {
+      counter_bond_atom[i][j] = counter_bond_atom_local[i][j] = 0;
+      global_bond_atom[i][j] = global_bond_atom_local[i][j] = 0;
+    }
+  }
+
+  int natoms = atom->natoms;
+  int ii, i, nbonds, jj, j, m;
+  int nn;
+  tagint *tag = atom->tag;
+  tagint **bond_atom = atom->bond_atom;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  ilist = list->ilist;
+  firstneigh = list->firstneigh;
+  nn = list->inum;
+  numneigh = list->numneigh;
+  int jnum, itag, jtag;
+  int nlocal = atom->nlocal;
+  int *mask = atom->mask;
+  int newton_pair = force->newton_pair;
+
+  for (ii = 0; ii < nn; ii++) { 
+    i = ilist[ii];
+    nbonds = atom->num_bond[i]; 
+    if (!(mask[i] & groupbit))
+      continue;
+    itag = tag[i];
+    for (jj = 0; jj < natoms; jj++) {
+      jtag = jj + 1;
+      for (m = 0; m < nbonds; m++) {
+        if (jtag == bond_atom[i][m]) {                                        
+          counter_bond_atom_local[jtag][counter_num_bond_local[jtag]] = itag; 
+          counter_num_bond_local[jtag] += 1;
+          global_bond_atom_local[itag][global_num_bond_local[itag]] = jtag; 
+          global_num_bond_local[itag] += 1;
+          khs_local[itag * natoms + jtag] = 1;
+          khs_local[jtag * natoms + itag] = 1;
+          break;
+        }
+      }
+    }
+  }
+
+  int **size_buf_rnk;
+  int **disp_buf_rnk;
+  int nprocs = comm->nprocs;
+  memory->create(size_buf_rnk, ndim, nprocs, "psq:size_buf_rnk"); 
+  memory->create(disp_buf_rnk, ndim, nprocs, "psq:disp_buf_rnk"); 
+  for (ii = 1; ii < ndim; ii++) {
+    MPI_Allgather(&(counter_num_bond_local[ii]), 1, MPI_INT, size_buf_rnk[ii], 1, MPI_INT, world); 
+  }
+
+  for (ii = 1; ii < ndim; ii++) {
+    disp_buf_rnk[ii][0] = 0;
+    for (i = 1; i < nprocs; i++)
+      disp_buf_rnk[ii][i] = disp_buf_rnk[ii][i - 1] + size_buf_rnk[ii][i - 1];
+    MPI_Allgatherv(&(counter_bond_atom_local[ii][0]), counter_num_bond_local[ii], MPI_INT, &(counter_bond_atom[ii][0]), size_buf_rnk[ii], disp_buf_rnk[ii], MPI_INT, world);
+  }
+
+  memory->destroy(size_buf_rnk);
+  memory->destroy(disp_buf_rnk);
+
+  MPI_Allreduce(&(khs_local[0]), &(khs[0]), ndim * ndim, MPI_DOUBLE, MPI_MAX, world);
+  MPI_Allreduce(&(counter_num_bond_local[0]), &(counter_num_bond[0]), ndim, MPI_INT, MPI_SUM, world);
+  MPI_Allreduce(&(global_num_bond_local[0]), &(global_num_bond[0]), ndim, MPI_INT, MPI_SUM, world);
+  int bond = 8;
+  MPI_Allreduce(&(global_bond_atom_local[0][0]), &(global_bond_atom[0][0]), ndim * bond, MPI_INT, MPI_MAX, world);
+
+	deallocate_matrix();
+	allocate_matrix();
+  init_storage();
+  init_storage2();
+
+
+  pre_force(vflag);
+}
