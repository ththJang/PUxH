+/* ---------------------------------------------------------------------- */
+
+void FixPQEq::set_Hydrogen()
+{
+  // J, R, K2 are setted based on q for Hydrogen.
+  // R : Linear Interpolation by C*Alpha^(1/3). R0(Parameter Input) when q=0.
+  // J = qqrd2e * sqrt (lambda / pi) / R
+  // K2 = 332.0637 / polarizability where polarizability from q.
+  int ii, i;
+
+  double *q = atom->q;
+  double eta_0, eta_q;
+
+  eta_0 = 0.29481; // atomic polarizability of Hydrogen(from H2) when q=0
+  for (ii = 0; ii < nn; ++ii) {
+    i = ilist[ii];
+    if (atom->mask[i] & groupbit) {
+      if (atom->type[i] == 1) { //Assume it is Hydrogen
+        // Calculate Atomic polarizability, eta
+        if (q[i] >= 0.0 && q[i] < 1.0) eta_q = -0.2447*q[i]*q[i]-0.0502*q[i]+0.2948;
+        else if (q[i] < 0.0 && q[i] > -1.0) eta_q = -31.713*q[i]+0.2948;
+        else {
+          error->warning(FLERR,"Warning: Hydrogen charge is not in the range of -1 <= q <= 1. Neutral paramter is assumed");
+          eta_q = eta_0;
+        }
+
+        J_coeff[i] = pow((eta_0/eta_q),(1.0/3.0));
+        Alpha_coeff[i] = pow((eta_0/eta_q),(2.0/3.0));
+        K2_coeff[i] = eta_0/eta_q;
+      }
+      else {
+        J_coeff[i] = 1.0;
+        Alpha_coeff[i] = 1.0;
+        K2_coeff[i] = 1.0; 
+      }
+    }
+  }
+}
