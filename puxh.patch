+      pack_choice[i] = &ComputeSpecAtomRexPoN::pack_abo20;
+    } else if (strcmp(arg[iarg],"abo21") == 0) {
+      pack_choice[i] = &ComputeSpecAtomRexPoN::pack_abo21;
+    } else if (strcmp(arg[iarg],"abo22") == 0) {
+      pack_choice[i] = &ComputeSpecAtomRexPoN::pack_abo22;
+    } else if (strcmp(arg[iarg],"abo23") == 0) {
+      pack_choice[i] = &ComputeSpecAtomRexPoN::pack_abo23;
+    } else if (strcmp(arg[iarg],"abo24") == 0) {
+      pack_choice[i] = &ComputeSpecAtomRexPoN::pack_abo24;
+
+    } else error->all(FLERR,"Invalid keyword in compute spec/atom command");
+  }
+
+  nmax = 0;
+  vector = nullptr;
+  array = nullptr;
+
+}
+
+/* ---------------------------------------------------------------------- */
+
+ComputeSpecAtomRexPoN::~ComputeSpecAtomRexPoN()
+{
+  delete [] pack_choice;
+  memory->destroy(vector);
+  memory->destroy(array);
+}
+
+/* ---------------------------------------------------------------------- */
+
+void ComputeSpecAtomRexPoN::compute_peratom()
+{
+  invoked_peratom = update->ntimestep;
+
+  // grow vector or array if necessary
+
+  if (atom->nmax > nmax) {
+    nmax = atom->nmax;
+    if (nvalues == 1) {
+      memory->destroy(vector);
+      memory->create(vector,nmax,"property/atom:vector");
+      vector_atom = vector;
+    } else {
+      memory->destroy(array);
+      memory->create(array,nmax,nvalues,"property/atom:array");
+      array_atom = array;
+    }
+  }
+
+  // fill vector or array with per-atom values
+
+  if (nvalues == 1) {
+    buf = vector;
+    (this->*pack_choice[0])(0);
+  } else {
+    if (nmax > 0) {
+      buf = &array[0][0];
+      for (int n = 0; n < nvalues; n++)
+        (this->*pack_choice[n])(n);
+    }
+  }
+}
+
+/* ----------------------------------------------------------------------
+   memory usage of local atom-based array
+------------------------------------------------------------------------- */
+
+double ComputeSpecAtomRexPoN::memory_usage()
+{
+  double bytes = (double)nmax*nvalues * sizeof(double);
+  return bytes;
+}
