+------------------------------------------------------------------------- */
+
+#include "fix_rigid_small.h"
+
+#include "atom.h"
+#include "atom_vec_ellipsoid.h"
+#include "atom_vec_line.h"
+#include "atom_vec_tri.h"
+#include "comm.h"
+#include "domain.h"
+#include "error.h"
