+
+#define SQR(x) ((x)*(x))
+#define CUBE(x) ((x)*(x)*(x))
+
+/* ---------------------------------------------------------------------- */
+
+PairUnbCoulPqeqgauss::PairUnbCoulPqeqgauss(LAMMPS *lmp) : Pair(lmp)
+{
+  ewaldflag = 1;
+  single_enable = 0;
+  writedata = 1;
+  ghostneigh = 1;
+}
+
+/* ---------------------------------------------------------------------- */
+
+PairUnbCoulPqeqgauss::~PairUnbCoulPqeqgauss()
+{
+  if (copymode) return;
+
+  if (allocated) {
+    memory->destroy(setflag);
+    memory->destroy(cutsq);
+
+    // UNB Part
+    memory->destroy(R_UNB);
+    memory->destroy(D_UNB);
+    memory->destroy(L_UNB);
+
+    // PQEq Part
+    memory->destroy(chi);
+    memory->destroy(idem);
+    memory->destroy(rcore);
+    memory->destroy(polar);
+    memory->destroy(qcore);
+    memory->destroy(rshell);
+    memory->destroy(kstring2);
+    memory->destroy(kstring4);
+    memory->destroy(alphass);
+    memory->destroy(alphasc);
+    memory->destroy(alphacc);
+    memory->destroy(swab);
+    memory->destroy(cutghost);
+  }
+}
+
+/* ---------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::compute(int eflag, int vflag)
+{
+  int i, j, ii, jj, inum, jnum, itype, jtype, n;
+  double qi,qj,xi,xj,yi,yj,zi,zj, delx, dely, delz, evdwl, ecoul, fpair;
+  double r, r2, r3, r4, r5, rsq, r2inv, rinv, forcelj, forcecoul, factor_lj, factor_coul;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  
+  int polari,polarj;
+  double alpha,chii,idemi,kstring2i,kstring4i;
+  double shell_eng,coulombr,dcoulombr;
+  double q1,q2,qcorei,qcorej,qshelli,qshellj,rsxi,rsxj,rsyi,rsyj,rszi,rszj;
+
+  double taper,dtaper;
+  double R,D,L;
+  double exp1,exp2,dexp1,dexp2,e_vdW,de_vdW;
+
+  evdwl = ecoul = 0.0;
+  ev_init(eflag, vflag);
+
+  double **x = atom->x;
+  double **f = atom->f;
+  double *q = atom->q;
+  double **rsx = atom->rsx;
+  int *type = atom->type;
+  int *tag = atom->tag;
+  double SMALL = 0.0001;
+  int nlocal = atom->nlocal;
+  double *special_coul = force->special_coul;
+  double *special_lj = force->special_lj;
+  int newton_pair = force->newton_pair;
+  double qqrd2e = force->qqrd2e;
+  double qe2f = force->qe2f;
+
+  inum = list->inum;
+  ilist = list->ilist;
+  numneigh = list->numneigh;
+  firstneigh = list->firstneigh;
+
+  // loop over neighbors of my atoms
+
+  for (ii = 0; ii < inum; ii++) {
+    i = ilist[ii];
+    qi = q[i];
+    xi = x[i][0];
+    yi = x[i][1];
+    zi = x[i][2];
+    itype = type[i];
+    polari = polar[itype];
+    chii = qe2f*chi[itype];
+    idemi = qe2f*idem[itype];
+    jlist = firstneigh[i];
+    jnum = numneigh[i];
+
+    // Self energy, only on i atom
+    if (polari && atom->pqeq_flag) {
+      kstring2i = kstring2[itype];
+      kstring4i = kstring4[itype];
+      qcorei = qcore[itype];
+      qshelli = -qcorei;
+      rsxi = rsx[i][0];
+      rsyi = rsx[i][1];
+      rszi = rsx[i][2];
+      rsq = rsxi*rsxi + rsyi*rsyi + rszi*rszi;
+      r = sqrt(rsq);
+      shell_eng = 0.50 * kstring2i * rsq + kstring4i * rsq * rsq;
+    }
+    else shell_eng = qcorei = 0.0;
+
+    if (eflag) ecoul = chii * qi + 0.5 * idemi * qi * qi + shell_eng;
+
+    if (evflag) ev_tally(i,i,nlocal,0,0.0,ecoul,0.0,0.0,0.0,0.0);
+
+    q1 = qcorei + qi;
+
+    for (jj = 0; jj < jnum; jj++) {
+      j = jlist[jj];
+      factor_lj = special_lj[sbmask(j)];
+      factor_coul = special_coul[sbmask(j)];
+      j &= NEIGHMASK;
+
+      xj = x[j][0];
+      yj = x[j][1];
+      zj = x[j][2];
+
+      delx = xi - xj;
+      dely = yi - yj;
+      delz = zi - zj;
+      rsq = delx * delx + dely * dely + delz * delz;
+      jtype = type[j];
+
+      if (rsq <= SQR(swb_unb) || rsq <= SQR(swb)) {
+        // Init Taper for UNB
+        if (taper_flag) {
+          taper = Tap_unb[7];
+          dtaper = dTap_unb[7];
+          for (int n = 6; n >= 0; n--) {
+            taper = taper * sqrt(rsq) + Tap_unb[n];
+            dtaper = dtaper * sqrt(rsq) + dTap_unb[n];
+          }
+          if (rsq >= SQR(swb_unb)) {
+            taper = 0.0;
+            dtaper = 0.0;
+          }
+        }
+        else {
+          taper = 1.0;
+          dtaper = 0.0;
+        }
+
+        // UNB Part
+        R = R_UNB[itype][jtype];
+        D = D_UNB[itype][jtype];
+        L = L_UNB[itype][jtype];
+
+        r = (sqrt(rsq) - R) / L;
+        r2 = r * r;
+        r3 = r2 * r;
+        r4 = r3 * r;
+        r5 = r4 * r;
+
+        exp1 = -D * exp(-beta * r);
+        exp2 = s0 + s1 * r + s2 * r2 + s3 * r3 + s4 * r4 + s5 * r5;
+        e_vdW = exp1 * exp2;
+
+        dexp1 = -beta * exp1 / L;
+        dexp2 = (s1 + 2.0 * s2 * r + 3.0 * s3 * r2 + 4.0 * s4 * r3 + 5.0 * s5 * r4) / L;
+        de_vdW = (dexp1 * exp2 + exp1 * dexp2);
+
+        fpair = -(taper * de_vdW + dtaper * e_vdW) / sqrt(rsq);
+
+        f[i][0] += factor_lj * delx * fpair;
+        f[i][1] += factor_lj * dely * fpair;
+        f[i][2] += factor_lj * delz * fpair;
+        if (newton_pair || j < nlocal) {
+          f[j][0] -= factor_lj * delx * fpair;
+          f[j][1] -= factor_lj * dely * fpair;
+          f[j][2] -= factor_lj * delz * fpair;
+        }
+        if (eflag) evdwl = factor_lj * taper * e_vdW;
+
+        if (evflag) ev_tally(i, j, nlocal, newton_pair, evdwl, 0.0, fpair, delx, dely, delz);
+
+        // Coulomb Part
+        if (!ewald_flag) {
+          qj = q[j];
+          jtype = type[j];
+          polarj = polar[jtype];
+  
+          if (polarj) {
+            qcorej = qcore[jtype];
+            qshellj = -qcore[jtype];
+            rsxj = rsx[j][0];
+            rsyj = rsx[j][1];
+            rszj = rsx[j][2];
+          } else qcorej = 0.0; 
+  
+          q2 = qcorej + qj;
+  
+          // Core - Core
+          alpha = alphacc[itype][jtype];
+          r = sqrt(rsq);
+          coulomb(r, alpha, &coulombr, &dcoulombr);
+          fpair = -dcoulombr * q1 * q2 /r;
+  
+          f[i][0] += factor_coul * delx * fpair;
+          f[i][1] += factor_coul * dely * fpair;
+          f[i][2] += factor_coul * delz * fpair;
+          if (newton_pair || j < nlocal) {
+            f[j][0] -= factor_coul * delx * fpair;
+            f[j][1] -= factor_coul * dely * fpair;
+            f[j][2] -= factor_coul * delz * fpair;
+          }
+  
+          if (eflag) ecoul = factor_coul * coulombr * q1 * q2;
+  
+          if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+          
+          // Shell - Shell
+          if (polari && polarj) {
+            alpha = alphass[itype][jtype];
+            delx = rsxi - rsxj + delx;
+            dely = rsyi - rsyj + dely;
+            delz = rszi - rszj + delz;
+            rsq = delx * delx + dely * dely + delz * delz;
+            r = sqrt(rsq);
+            coulomb(r, alpha, &coulombr, &dcoulombr);
+            fpair = -dcoulombr * qshelli * qshellj /r;
+    
+            f[i][0] += factor_coul * delx * fpair;
+            f[i][1] += factor_coul * dely * fpair;
+            f[i][2] += factor_coul * delz * fpair;
+            if (newton_pair || j < nlocal) {
+              f[j][0] -= factor_coul * delx * fpair;
+              f[j][1] -= factor_coul * dely * fpair;
+              f[j][2] -= factor_coul * delz * fpair;
+            }
+  
+            if (eflag) ecoul = factor_coul * coulombr * qshelli * qshellj;
+  
+            if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+   
+          }
+  
+          // Shell i - Core j
+          if (polari) {
+            alpha = alphasc[itype][jtype];
+            delx = (rsxi + xi) - xj;
+            dely = (rsyi + yi) - yj;
+            delz = (rszi + zi) - zj;
+            rsq = delx * delx + dely * dely + delz * delz;
+            r = sqrt(rsq);
+            coulomb(r, alpha, &coulombr, &dcoulombr);
+            fpair = -dcoulombr * qshelli * q2 /r;
+    
+            f[i][0] += factor_coul * delx * fpair;
+            f[i][1] += factor_coul * dely * fpair;
+            f[i][2] += factor_coul * delz * fpair;
+            if (newton_pair || j < nlocal) {
+              f[j][0] -= factor_coul * delx * fpair;
+              f[j][1] -= factor_coul * dely * fpair;
+              f[j][2] -= factor_coul * delz * fpair;
+            }
+  
+            if (eflag) ecoul = factor_coul * coulombr * qshelli * q2;
+  
+            if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+   
+          }
+  
+          // Core i - Shell j
+          if (polarj) {
+            alpha = alphasc[jtype][itype];
+            delx = xi - (rsxj + xj);
+            dely = yi - (rsyj + yj);
+            delz = zi - (rszj + zj);
+            rsq = delx * delx + dely * dely + delz * delz;
+            r = sqrt(rsq);
+            coulomb(r, alpha, &coulombr, &dcoulombr);
+            fpair = -dcoulombr * q1 * qshellj /r;
+    
+            f[i][0] += factor_coul * delx * fpair;
+            f[i][1] += factor_coul * dely * fpair;
+            f[i][2] += factor_coul * delz * fpair;
+            if (newton_pair || j < nlocal) {
+              f[j][0] -= factor_coul * delx * fpair;
+              f[j][1] -= factor_coul * dely * fpair;
+              f[j][2] -= factor_coul * delz * fpair;
+            }
+  
+            if (eflag) ecoul = factor_coul * coulombr * q1 * qshellj;
+  
+            if (evflag) ev_tally(i, j, nlocal, newton_pair, 0.0, ecoul, fpair, delx, dely, delz);
+   
+          }
+        }
+      }
+    }
+  }
+
+  if (vflag_fdotr) virial_fdotr_compute();
+}
+
+/* ----------------------------------------------------------------------
+   allocate all arrays
+------------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::allocate()
+{
+  allocated = 1;
+  int np1 = atom->ntypes + 1;
+
+  memory->create(setflag, np1, np1, "pair:setflag");
+  for (int i = 1; i < np1; i++) {
+    for (int j = i; j < np1; j++) {
+      setflag[i][j] = 0;
+    }
+  }
+
+  // UNB Part
+  memory->create(R_UNB,np1,np1,"pair:R_UNB");
+  memory->create(D_UNB,np1,np1,"pair:D_UNB");
+  memory->create(L_UNB,np1,np1,"pair:L_UNB");
+
+  // PQEq Part
+  memory->create(cutsq,np1,np1,"pair:cutsq");
+  memory->create(chi,np1,"pair:chi");
+  memory->create(idem,np1,"pair:idem");
+  memory->create(rcore,np1,"pair:rcore");
+  memory->create(polar,np1,"pair:polar");
+  memory->create(qcore,np1,"pair:qcore");
+  memory->create(rshell,np1,"pair:rshell");
+  memory->create(kstring2,np1,"pair:kstring2");
+  memory->create(kstring4,np1,"pair:kstring4");
+  memory->create(alphass,np1,np1,"pair:alphass");
+  memory->create(alphasc,np1,np1,"pair:alphasc");
+  memory->create(alphacc,np1,np1,"pair:alphacc");
+  memory->create(swab,2,"pair:cutoutin");
+  memory->create(cutghost,np1,np1,"pair:cutghost");
+}
+
+/* ----------------------------------------------------------------------
+   global settings
+------------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::settings(int narg, char **arg)
+{
+  if ((narg < 2) || (narg > 5))
+    error->all(FLERR,"Illegal pair_style command");
+
+  swa_unb = 0.0;
+  swb_unb = utils::numeric(FLERR,arg[0],false,lmp);
+
+  // default values
+  taper_flag = 1;
+
+  if (narg == 2) {
+    swa = 0.0;
+    swb = swb_unb;
+    ewald_flag = utils::inumeric(FLERR,arg[1],false,lmp);
+  }
+  else if (narg == 3) {
+    swa = 0.0;
+    swb = utils::numeric(FLERR,arg[1],false,lmp);
+    ewald_flag = utils::inumeric(FLERR,arg[2],false,lmp);
+  }
+  else if ((narg == 4) && strcmp(arg[2],"taper") == 0) {
+    swa = 0.0;
+    swb = swb_unb;
+    ewald_flag = utils::inumeric(FLERR,arg[1],false,lmp);
+    taper_flag = utils::inumeric(FLERR,arg[3],false,lmp);
+  }
+  else if ((narg == 5) && strcmp(arg[3],"taper") == 0) {
+    swa = 0.0;
+    swb = utils::numeric(FLERR,arg[1],false,lmp);
+    ewald_flag = utils::inumeric(FLERR,arg[2],false,lmp);
+    taper_flag = utils::inumeric(FLERR,arg[4],false,lmp);
+  }
+}
+
+/* ----------------------------------------------------------------------
+   set coeffs for one or more type pairs
+------------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::coeff(int narg, char **arg)
+{
+  if (narg < 13)
+    error->all(FLERR,"Incorrect args for pair coefficients");
+  if (!allocated) allocate();
+
+  int ilo, ihi, jlo, jhi;
+  utils::bounds(FLERR, arg[0], 1, atom->ntypes, ilo, ihi, error);
+  utils::bounds(FLERR, arg[1], 1, atom->ntypes, jlo, jhi, error);
+
+  /* values for offdiagonal coefficients are ignored since the PQEq 
+     formalism is diagnonal in the atom types*/
+  if ((ilo != jlo) or (ihi != jhi)) {
+    error->warning(FLERR,"Warning: when reading pair coefficients, nondiagonal values of PQEq are ignored");
+  }
+
+  // UNB Part
+  double R_one = utils::numeric(FLERR,arg[2],false,lmp);
+  double D_one = utils::numeric(FLERR,arg[3],false,lmp);
+  double L_one = utils::numeric(FLERR,arg[4],false,lmp);
+
+  // PQEq Part
+  double chi_one = utils::numeric(FLERR,arg[5],false,lmp);
+  double idem_one = utils::numeric(FLERR,arg[6],false,lmp);
+  double rcore_one = utils::numeric(FLERR,arg[7],false,lmp);
+  int polar_one = utils::inumeric(FLERR,arg[8],false,lmp);
+  double qcore_one = utils::numeric(FLERR,arg[9],false,lmp);
+  double rshell_one = utils::numeric(FLERR,arg[10],false,lmp);  
+  double kstring2_one = utils::numeric(FLERR,arg[11],false,lmp);
+  double kstring4_one = utils::numeric(FLERR,arg[12],false,lmp);
+
+  int count = 0;
+  for (int i = ilo; i <= ihi; i++) {
+    for (int j = jlo; j <= jhi; j++) {
+      // UNB Part, allow off-diagonal
+      R_UNB[i][j] = R_one;
+      D_UNB[i][j] = D_one;
+      L_UNB[i][j] = L_one;
+      R_UNB[j][i] = R_one;
+      D_UNB[j][i] = D_one;
+      L_UNB[j][i] = L_one;
+
+      if (i == j) {
+        // PQEq Part
+        chi[i] = chi_one;
+        idem[i] = idem_one;
+        rcore[i] = rcore_one;
+        polar[i] = polar_one;
+        qcore[i] = qcore_one;
+        rshell[i] = rshell_one;
+        kstring2[i] = kstring2_one;
+        kstring4[i] = kstring4_one;
+      }
+      count++;
+      setflag[i][j] = 1;
+    }
+  }
+
+  if (count == 0) error->all(FLERR, "Incorrect args for pair coefficients");
+}
+
+/* ----------------------------------------------------------------------
+   init specific to this pair style
+------------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::init_style()
+{
+  if (!atom->q_flag) error->all(FLERR, "Pair style unb/pqeqgauss requires atom attribute q");
+
+  neighbor->add_request(this);
+
+  if ((swa_unb >= swb_unb) || (swa >= swb))
+    error->all(FLERR,"Pair inner cutoff >= Pair outer cutoff");
+
+  swa_unb2 = swa_unb * swa_unb;
+  swb_unb2 = swb_unb * swb_unb;
+  swb_unb3 = swb_unb2 * swb_unb;
+  swa_unb3 = swa_unb2 * swa_unb;
+  swa2 = swa * swa;
+  swb2 = swb * swb;
+  swb3 = swb2 * swb;
+  swa3 = swa2 * swa;
+
+  // Global Parameters for UNB, J. Chem. Phys. 151, 154111 (2019)
+  //beta = 1.0035;
+  //s0 = 1.0000;
+  //s1 = 1.0201;
+  //s2 = 0.0168;
+  //s3 = 0.0033;
+  //s4 = 0.0037;
+  //s5 = 0.0011;
+
+  // From Saber's code
+  beta = 1.00348500;
+  s0 = 1.0;
+  s1 = 1.02009000;
+  s2 = 0.01678480;
+  s3 = 0.00327294;
+  s4 = 0.00365706;
+  s5 = 0.00106613;
+
+  init_taper();      
+
+}
+
+/* ----------------------------------------------------------------------
+   init for one type pair i,j and corresponding j,i
+------------------------------------------------------------------------- */
+
+double PairUnbCoulPqeqgauss::init_one(int i, int j)
+{
+  // UNB Part
+  if (setflag[i][j] == 0) {// Geometric Mean is used when off-diagonal terms are undefined
+    R_UNB[i][j] = sqrt(R_UNB[i][i] * R_UNB[j][j]);
+    D_UNB[i][j] = sqrt(D_UNB[i][i] * D_UNB[j][j]);
+    L_UNB[i][j] = sqrt(L_UNB[i][i] * L_UNB[j][j]);
+    R_UNB[j][i] = sqrt(R_UNB[i][i] * R_UNB[j][j]);
+    D_UNB[j][i] = sqrt(D_UNB[i][i] * D_UNB[j][j]);
+    L_UNB[j][i] = sqrt(L_UNB[i][i] * L_UNB[j][j]);
+  }
+
+  // PQEq Part
+  double lambda = 0.462770;
+  //double lambda = 1.00000;
+
+  double alpha_ci = lambda * 0.5 / rcore[i] / rcore[i];
+  double alpha_cj = lambda * 0.5 / rcore[j] / rcore[j];
+
+  alphacc[i][j] = sqrt(alpha_ci*alpha_cj/(alpha_ci+alpha_cj));
+  alphacc[j][i] = alphacc[i][j];
+
+  if (polar[i]) {
+    double alpha_si = lambda * 0.5 / rshell[i] / rshell[i];
+    alphasc[i][j] = sqrt(alpha_si*alpha_cj/(alpha_si+alpha_cj));   
+    if  (polar[j]) {
+      double alpha_sj = lambda * 0.5 / rshell[j] / rshell[j];
+      alphasc[j][i] = sqrt(alpha_sj*alpha_ci/(alpha_sj+alpha_ci));   
+      alphass[i][j] = sqrt(alpha_si*alpha_sj/(alpha_si+alpha_sj));
+      alphass[j][i] = alphass[i][j];
+    }
+  } else {
+    if  (polar[j]) {
+      double alpha_sj = lambda * 0.5 / rshell[j] / rshell[j];
+      alphasc[j][i] = sqrt(alpha_ci*alpha_sj/(alpha_ci+alpha_sj));
+    }
+  }
+
+  cutghost[i][j] = cutghost[j][i] = swb;
+
+  return swb;
+}
+
+/* ----------------------------------------------------------------------
+  proc 0 writes to restart file
+------------------------------------------------------------------------- */
+
+void PairUnbCoulPqeqgauss::write_restart(FILE *fp)
+{
+  write_restart_settings(fp);
+
+  int i, j;
+  for (i = 1; i <= atom->ntypes; i++) {
+    // UNB Part
+    for (j = i; j <= atom->ntypes; j++) {
+      fwrite(&setflag[i][j],sizeof(int),1,fp);
+      fwrite(&R_UNB[i][j],sizeof(double),1,fp);
+      fwrite(&D_UNB[i][j],sizeof(double),1,fp);
+      fwrite(&L_UNB[i][j],sizeof(double),1,fp);
+    }
+ 
+    // PQEq Part
+    fwrite(&chi[i],sizeof(double),1,fp);
+    fwrite(&idem[i],sizeof(double),1,fp);
+    fwrite(&rcore[i],sizeof(double),1,fp);
+    fwrite(&polar[i],sizeof(int),1,fp);
+    fwrite(&qcore[i],sizeof(double),1,fp);
+    fwrite(&rshell[i],sizeof(double),1,fp);
+    fwrite(&kstring2[i],sizeof(double),1,fp);
+    fwrite(&kstring4[i],sizeof(double),1,fp);
+  }
+}
