+  int nbonds1, nbonds2;
+
+  for (ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    q_old = saveq[i];
+    q_new = q[i];
+    q[i] = damp * q_new + (1 - damp) * q_old;
+  }
+
+  pack_flag = 4;
+  comm->forward_comm(this); // Dist_vector( atom->q );
+}
