+/* ----------------------------------------------------------------------
+   invoke pre_neighbor() to insure body xcmimage flags are reset
+     needed if Verlet::setup::pbc() has remapped/migrated atoms for 2nd run
+------------------------------------------------------------------------- */
+
+void FixRigid::setup_pre_neighbor()
+{
+  pre_neighbor();
+}
