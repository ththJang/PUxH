+/* ---------------------------------------------------------------------- */
+
+void FixPSQ::pre_force(int vflag) {
+  double t_start, t_end;
+
+  if( comm->me == 0 ) t_start = MPI_Wtime();
+
+  int method; //0 for Only QEq, 1 for Only Shell, 2 for Full PQEq
+
+  if (nevery == 0 && nshellevery == 0) return; //0 means that we do not calculate
+  else if (nevery != 0 && nshellevery == 0) {
+    method = 0;//Only QEq
+    if(update->ntimestep % nevery) return;
+  }
+  else if (nevery == 0 && nshellevery != 0) {
+    method = 1;//Only Shell
+    if(update->ntimestep % nshellevery) return;
+  }
+  else {
+    method = 2;//Full PQEq
+    if((update->ntimestep % nevery) && !(update->ntimestep % nshellevery)) method = 1;
+    else if(!(update->ntimestep % nevery) && (update->ntimestep % nshellevery)) method = 0;
+    else if((update->ntimestep % nevery) && (update->ntimestep % nshellevery)) return;
+  }
+
+  n = atom->nlocal;
+  N = atom->nlocal + atom->nghost;
+
+  if( n > n_cap*DANGER_ZONE || m_fill > m_cap*DANGER_ZONE ){
+    reallocate_matrix();
+	}
+
+  if (method == 0) { // QEq with charge updates every ntimesteps
+    cqf = 0.0;
+    init_matvec();
+    init_matvec2();
+		save_Q();
+    matvecs = CG(chis, qifj_CRS_val); // CG on s - parallel
+  } else if (method == 1) { // only shell updates
+    sforce();
+    calculate_Shell();
+  } else if (method == 2) { // full PQEq
+    cqf = 1.0;
+    init_storage();
+		save_Q();
+    init_matvec();
+    for (int i = 0; i < ncycle; i++) {
+      init_matvec2();
+
+      matvecs = CG(chis, qifj_CRS_val);
+      sforce();
+      calculate_Shell();
+    }
+  }
+	if (damp < 1.0 ) {
+		calculate_Qdamp();
+		sforce();
+    calculate_Shelldamp();
+	}
+
+  if (comm->me == 0) {
+    t_end = MPI_Wtime();
+    pqeq_time = t_end - t_start;
+  }
+}
