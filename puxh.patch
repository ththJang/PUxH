+
+  // parameters of the UNB
+  double **R_UNB;
+  double **D_UNB;
+  double **L_UNB;
+
+ protected:
+  int implicit;
+  double cut_lj;
+  double cut_ljsq;
+  double cut_coul, cut_coulsq;
+  double cut_bothsq;
+
+  // Global paremters of the UNB
+  double beta,s0,s1,s2,s3,s4,s5;
+
+  // cut offs for the taper
+  double swa,swb;   // read on the input
+  double swa2,swb2,swa3,swb3;
+  int taper_flag;
+  // taper coefficients
+  double Tap_unb[8];
+  double dTap_unb[8];
+  double Tap[8];
+  double dTap[8];
+
+  void init_taper();
+
+  double cut_global;
+  double **cut;
+
+  virtual void allocate();
+};
+
+}    // namespace LAMMPS_NS
+
+#endif
+#endif
