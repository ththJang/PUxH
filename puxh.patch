+
+#define SQR(x) ((x)*(x))
+#define CUBE(x) ((x)*(x)*(x))
+
+static constexpr double EV_TO_KCAL_PER_MOL = 14.4;
+static constexpr double QSUMSMALL = 0.00001;
+static constexpr double DANGER_ZONE = 0.95;
+static constexpr double LOOSE_ZONE = 0.7;
+static constexpr int MIN_NBRS = 100;
+static constexpr int MIN_CAP = 200;
+static constexpr double SAFE_ZONE = 2.0;
+
+static const char cite_fix_pqeq[] =
+  "fix pqeq command\n\n";
+
+/* ---------------------------------------------------------------------- */
+
+FixPQEq::FixPQEq(LAMMPS *lmp, int narg, char **arg) :
+  Fix(lmp, narg, arg), matvecs(0)
+{
+  scalar_flag = 1;
+  extscalar = 0;
+  maxwarn = 1;
+
+  if ((narg < 8) || (narg > 14)) error->all(FLERR,"Illegal fix pqeq command");
+
+  // default values
+  netchg = 0.0;
+  damp = 1.0;
+  nshelliter = 1;
+  Hiter = 0;
+
+  nevery = utils::inumeric(FLERR,arg[3],false,lmp);
+  nshellevery = utils::inumeric(FLERR,arg[4],false,lmp);
+  ncycle = utils::inumeric(FLERR,arg[5],false,lmp);
+  if (nevery < 0 || nshellevery < 0 || ncycle < 0) error->all(FLERR,"Illegal fix pqeq command");
+
+  tolerance = utils::numeric(FLERR,arg[6],false,lmp);
+  numCG = utils::inumeric(FLERR,arg[7],false,lmp); 
+
+  int iarg = 8;
+  while (iarg < narg) {
+    if (strcmp(arg[iarg],"nowarn") == 0) maxwarn = 0;
+    else if (strcmp(arg[iarg],"maxiter") == 0) {
+      if (iarg+2 > narg)
+        error->all(FLERR,"Illegal fix {} command", style);
+      numCG = utils::numeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"charge") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal fix {} command", style);
+      netchg = utils::numeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"damp") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal fix {} command", style);
+      damp = utils::numeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"Hiter") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal fix {} command", style);
+      Hiter = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+    else if (strcmp(arg[iarg],"nshelliter") == 0) {
+      if (iarg+2 > narg) error->all(FLERR,"Illegal fix {} command", style);
+      nshelliter = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    } else error->all(FLERR,"Illegal fix {} command", style);
+    iarg++;
+  }
+
+  nn = n_cap = 0;
+  nmax = 0;
+  m_fill = m_cap = 0;
+  pack_flag = 0;
+  s = nullptr;
+  t = nullptr;
+
+  nprev = 5;
+
+  Hdia_inv = nullptr;
+  b_s = nullptr;
+  b_t = nullptr;
+  b_prc = nullptr;
+  b_prm = nullptr;
+
+  // Hiter
+  J_coeff = nullptr;
+  Alpha_coeff = nullptr;
+  K2_coeff = nullptr;
+
+  // CG
+
+  p = nullptr;
+  q = nullptr;
+  r = nullptr;
+  d = nullptr;
+
+  // H matrix
+
+  H.firstnbr = nullptr;
+  H.numnbrs = nullptr;
+  H.jlist = nullptr;
+  H.val = nullptr;
+
+  // Shell
+  qf = nullptr;
+  sf = nullptr;
+  cqf = 1.0;
+
+  comm_forward = comm_reverse = 3;
+
+  // perform initial allocation of atom-based arrays
+  // register with Atom class
+
+  s_hist = t_hist = nullptr;
+  grow_arrays(atom->nmax);
+  atom->add_callback(Atom::GROW);
+
+  for (int i = 0; i < atom->nmax; i++)
+    for (int j = 0; j < nprev; ++j)
+      s_hist[i][j] = t_hist[i][j] = 0;
+
+  pqeq = NULL;
+  pqeq = dynamic_cast<Pair *>( force->pair_match("**coul/pqeqgauss",1));
+}
