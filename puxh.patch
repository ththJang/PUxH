+struct storage {
+  int allocated;
+
+  /* bond order related storage */
+  double *total_bond_order;
+  double *Deltap, *Deltap_boc;
+  double *Delta, *Delta_lp, *Delta_lp_temp, *Delta_e, *Delta_boc, *Delta_val;
+  double *dDelta_lp, *dDelta_lp_temp;
+  double *nlp, *nlp_temp, *Clp, *vlpex;
