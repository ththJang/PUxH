+/* ---------------------------------------------------------------------- */
+
+void PairReaxFFRexPoN::get_distance(rvec xj, rvec xi, double *d_sqr, rvec *dvec)
+{
+  (*dvec)[0] = xj[0] - xi[0];
+  (*dvec)[1] = xj[1] - xi[1];
+  (*dvec)[2] = xj[2] - xi[2];
+  *d_sqr = SQR((*dvec)[0]) + SQR((*dvec)[1]) + SQR((*dvec)[2]);
+}
