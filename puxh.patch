+ComputeSpecAtomRexPoN::ComputeSpecAtomRexPoN(LAMMPS *lmp, int narg, char **arg) :
+  Compute(lmp, narg, arg)
+{
+  if (narg < 4) error->all(FLERR,"Illegal compute spec/atom command");
+
+  peratom_flag = 1;
+  nvalues = narg - 3;
+  if (nvalues == 1) size_peratom_cols = 0;
+  else size_peratom_cols = nvalues;
+
+  // get reference to ReaxFF pair style
+  reaxff_rexpon = dynamic_cast<PairReaxFFRexPoN *>( force->pair_match("^reax..",0));
+
+  pack_choice = new FnPtrPack[nvalues];
+
+  int i;
+  for (int iarg = 3; iarg < narg; iarg++) {
+    i = iarg-3;
+
+    // standard lammps attributes
+    if (strcmp(arg[iarg],"q") == 0) {
