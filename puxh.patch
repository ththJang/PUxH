+/* ----------------------------------------------------------------------
+   pack entire state of Fix into one write
+------------------------------------------------------------------------- */
+
+void FixCMAP::write_restart(FILE *fp)
+{
+  if (comm->me == 0) {
+    int size = sizeof(bigint);
+    fwrite(&size,sizeof(int),1,fp);
+    fwrite(&ncmap,sizeof(bigint),1,fp);
+  }
+}
