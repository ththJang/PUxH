+   Contributing author: Minho M. Kim (KAIST, kmh173767@kaist.ac.kr)
+------------------------------------------------------------------------- */
+
+#include "pair_sw_angle.h"
+
+#include "atom.h"
+#include "comm.h"
+#include "error.h"
