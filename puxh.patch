+/* ----------------------------------------------------------------------
+   allocate all arrays
+------------------------------------------------------------------------- */
+
+void PairCoulPqeqgauss::allocate()
+{
+  allocated = 1;
+  int np1 = atom->ntypes + 1;
+
+  memory->create(setflag, np1, np1, "pair:setflag");
+  for (int i = 1; i < np1; i++) {
+    for (int j = i; j < np1; j++) {
+      setflag[i][j] = 0;
+    }
+  }
+
+  memory->create(cutsq,np1,np1,"pair:cutsq");
+  memory->create(chi,np1,"pair:chi");
+  memory->create(idem,np1,"pair:idem");
+  memory->create(rcore,np1,"pair:rcore");
+  memory->create(polar,np1,"pair:polar");
+  memory->create(qcore,np1,"pair:qcore");
+  memory->create(rshell,np1,"pair:rshell");
+  memory->create(kstring2,np1,"pair:kstring2");
+  memory->create(kstring4,np1,"pair:kstring4");
+  memory->create(alphass,np1,np1,"pair:alphass");
+  memory->create(alphasc,np1,np1,"pair:alphasc");
+  memory->create(alphacc,np1,np1,"pair:alphacc");
+  memory->create(swab,2,"pair:cutoutin");
+  memory->create(cutghost,np1,np1,"pair:cutghost");
+}
+
+/* ----------------------------------------------------------------------
+   global settings
+------------------------------------------------------------------------- */
+
+void PairCoulPqeqgauss::settings(int narg, char **arg)
+{
+  if ((narg < 3) || (narg > 5))
+    error->all(FLERR,"Illegal pair_style command");
+
+  swa = utils::numeric(FLERR,arg[0],false,lmp);
+  swb = utils::numeric(FLERR,arg[1],false,lmp);
+  ewald_flag = utils::inumeric(FLERR,arg[2],false,lmp);
+
+  // default values
+  taper_flag = 1;
+
+  int iarg = 3;
+  while (iarg < narg) {
+    if (strcmp(arg[iarg],"taper") == 0) {
+      if (iarg+2 > narg) 
+        error->all(FLERR,"Illegal pair_style command");
+      taper_flag = utils::inumeric(FLERR,arg[iarg+1],false,lmp);
+      iarg += 2;
+    }
+  }
+}
+
+/* ----------------------------------------------------------------------
+   set coeffs for one or more type pairs
+------------------------------------------------------------------------- */
+
+void PairCoulPqeqgauss::coeff(int narg, char **arg)
+{
+  if (narg != 10)
+    error->all(FLERR,"Incorrect args for pair coefficients");
+  if (!allocated) allocate();
+
+  int ilo, ihi, jlo, jhi;
+  utils::bounds(FLERR, arg[0], 1, atom->ntypes, ilo, ihi, error);
+  utils::bounds(FLERR, arg[1], 1, atom->ntypes, jlo, jhi, error);
+
+  /* values for offdiagonal coefficients are ignored since the PQEq 
+     formalism is diagnonal in the atom types*/
+  if ((ilo != jlo) or (ihi != jhi)) {
+    error->warning(FLERR,"Warning: when reading coul/pqeq pair coefficients, nondiagonal values are ignored");
+  }
+
+  double chi_one = utils::numeric(FLERR,arg[2],false,lmp);
+  double idem_one = utils::numeric(FLERR,arg[3],false,lmp);
+  double rcore_one = utils::numeric(FLERR,arg[4],false,lmp);
+  int polar_one = utils::inumeric(FLERR,arg[5],false,lmp);
+  double qcore_one = utils::numeric(FLERR,arg[6],false,lmp);
+  double rshell_one = utils::numeric(FLERR,arg[7],false,lmp);  
+  double kstring2_one = utils::numeric(FLERR,arg[8],false,lmp);
+  double kstring4_one = utils::numeric(FLERR,arg[9],false,lmp);
+
+  int count = 0;
+  for (int i = ilo; i <= ihi; i++) {
+    for (int j = jlo; j <= jhi; j++) {
+      if (i == j) {
+        chi[i] = chi_one;
+        idem[i] = idem_one;
+        rcore[i] = rcore_one;
+        polar[i] = polar_one;
+        qcore[i] = qcore_one;
+        rshell[i] = rshell_one;
+        kstring2[i] = kstring2_one;
+        kstring4[i] = kstring4_one;
+        count++;
+      }
+      setflag[i][j] = 1;
+    }
+  }
+
+  if (count == 0) error->all(FLERR, "Incorrect args for pair coefficients");
+}
+
+/* ----------------------------------------------------------------------
+   init specific to this pair style
+------------------------------------------------------------------------- */
+
+void PairCoulPqeqgauss::init_style()
+{
+  if (!atom->q_flag) error->all(FLERR, "Pair style coul/cut requires atom attribute q");
+
+  neighbor->add_request(this);
+
+  if (swa >= swb )
+    error->all(FLERR,"Pair inner cutoff >= Pair outer cutoff");
+
+  swa2 = swa * swa;
+  swb2 = swb * swb;
+  swb3 = swb2 * swb;
+  swa3 = swa2 * swa;
+
+  init_taper();      
+
+}
+
+/* ----------------------------------------------------------------------
+   init for one type pair i,j and corresponding j,i
+------------------------------------------------------------------------- */
+
+double PairCoulPqeqgauss::init_one(int i, int j)
+{
+  double lambda = 0.462770;
+  //double lambda = 1.00000;
+
+  double alpha_ci = lambda * 0.5 / rcore[i] / rcore[i];
+  double alpha_cj = lambda * 0.5 / rcore[j] / rcore[j];
+
+  alphacc[i][j] = sqrt(alpha_ci*alpha_cj/(alpha_ci+alpha_cj));
+  alphacc[j][i] = alphacc[i][j];
+
+  if (polar[i]) {
+    double alpha_si = lambda * 0.5 / rshell[i] / rshell[i];
+    alphasc[i][j] = sqrt(alpha_si*alpha_cj/(alpha_si+alpha_cj));   
+    if  (polar[j]) {
+      double alpha_sj = lambda * 0.5 / rshell[j] / rshell[j];
+      alphasc[j][i] = sqrt(alpha_sj*alpha_ci/(alpha_sj+alpha_ci));   
+      alphass[i][j] = sqrt(alpha_si*alpha_sj/(alpha_si+alpha_sj));
+      alphass[j][i] = alphass[i][j];
+    }
+  } else {
+    if  (polar[j]) {
+      double alpha_sj = lambda * 0.5 / rshell[j] / rshell[j];
+      alphasc[j][i] = sqrt(alpha_ci*alpha_sj/(alpha_ci+alpha_sj));
+    }
+  }
+
+  cutghost[i][j] = cutghost[j][i] = swb;
+
+  return swb;
+}
