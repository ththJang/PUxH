+            drdbo = 1.01*frac/(bos*(1.01-bos));
+	    double exp_term;
+	    exp_term = exp(-twbp->p_bo1 * (r_ij - twbp->p_bo2)/(twbp->r_s_bo-twbp->p_bo2));
+	    double dbodr = 1.01/(1+exp_term)/(1+exp_term)*exp_term/frac;
+            a0 = twbp->p_be1;
+            b0 = twbp->p_be2;
+            c0 = twbp->bom;
+            r0 = twbp->r_s;
