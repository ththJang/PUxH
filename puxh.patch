+                  }
+
+                  if (tor_flag[o][l][k][p] == 0) {
+                    fbp[o][l][k][p].cnt = 1;
+                    fbp[o][l][k][p].prm[0].V1 = val1;
+                    fbp[o][l][k][p].prm[0].V2 = val2;
+                    fbp[o][l][k][p].prm[0].V3 = val3;
+                    fbp[o][l][k][p].prm[0].p_tor1 = val4;
+                    fbp[o][l][k][p].prm[0].p_cot1 = val5;
+                  }
+                }
+              }
+            }
+          }
+        }
+
+        // next line is number of hydrogen bond parameters
+
+        values = reader.next_values(0);
+        n = values.next_int();
+        ++lineno;
+
+        for (i = 0; i < ntypes; ++i)
+          for (j = 0; j < ntypes; ++j)
+            for (k = 0; k < ntypes; ++k)
+              hbp[i][j][k].r0_hb = -1.0;
+
+        for (i = 0; i < n; ++i) {
+          // line 1: ReaxFF only has 4 parameter in line 1 whereas RexPoN has 24 paramters in total with 3 lines
+          values = reader.next_values(0);
+          ++lineno;
+          if (values.count() < 7)
+            THROW_ERROR("Invalid force field file format, first line in hbp");
+
+          j = values.next_int() - 1;
+          k = values.next_int() - 1;
+          l = values.next_int() - 1;
+
+          if ((j < 0) || (k < 0) || (l < 0))
+            THROW_ERROR("Inconsistent force field file");
+
+          if ((j < ntypes) && (k < ntypes) && (l < ntypes)) {
+            hbp[j][k][l].r0_hb = values.next_double();
+            hbp[j][k][l].p_hb1 = values.next_double();
+            hbp[j][k][l].p_hb2 = values.next_double();
+            hbp[j][k][l].p_hb3 = values.next_double();
+            if (control->reaxff_rexpon_hbond_flag) {
+              hbp[j][k][l].p_hb4 = values.next_double();
+            }
+            //RexPoN Water
+            if (control->reaxff_rexpon_hbond_flag!=0) {
+              hbp[j][k][l].p_hb5 = values.next_double();
+              hbp[j][k][l].p_hb6 = values.next_double();
+              hbp[j][k][l].p_hb7 = values.next_double();
+            }
+          }
+          if (control->reaxff_rexpon_hbond_flag!=0) { 
+            //line 2 for RexPoN
+            values = reader.next_values(0);
+            ++lineno;
+            if (values.count() < 8)
+              THROW_ERROR("Invalid force field file format, second line in hbp");
+
+            if ((j < ntypes) && (k < ntypes) && (l < ntypes)) {
+              hbp[j][k][l].p_hb8 = values.next_double();
+              hbp[j][k][l].p_hb9 = values.next_double();
+              hbp[j][k][l].p_hb10 = values.next_double();
+              hbp[j][k][l].p_hb11 = values.next_double();
+              hbp[j][k][l].p_hb12 = values.next_double();
+              hbp[j][k][l].p_hb13 = values.next_double();
+              hbp[j][k][l].p_hb14 = values.next_double();
+              hbp[j][k][l].p_hb15 = values.next_double();
+            }
+            //line 3 for RexPoN
+            values = reader.next_values(0);
+            ++lineno;
+            if (values.count() < 8)
+              THROW_ERROR("Invalid force field file format, third line in hbp");
+
+            if ((j < ntypes) && (k < ntypes) && (l < ntypes)) {
+              hbp[j][k][l].p_hb16 = values.next_double();
+              hbp[j][k][l].p_hb17 = values.next_double();
+              hbp[j][k][l].p_hb18 = values.next_double();
+              hbp[j][k][l].p_hb19 = values.next_double();
+              hbp[j][k][l].p_hb20 = values.next_double();
+              hbp[j][k][l].p_hb21 = values.next_double();
+              hbp[j][k][l].p_hb22 = values.next_double();
+              hbp[j][k][l].p_hb23 = values.next_double();
+            }
+          }
+        }
+
+        memory->destroy(tor_flag);
+      } catch (std::exception &e) {
+        error->one(FLERR,e.what());
+      }
+      fclose(fp);
+    }
+
+    // broadcast global parameters and allocate list on ranks != 0
+    MPI_Bcast(&reax_rexpon->gp,sizeof(global_parameters),MPI_CHAR,0,world);
+    if (control->me != 0) memory->create(reax_rexpon->gp.l,reax_rexpon->gp.n_global,"reaxff_rexpon:gp.l");
+    MPI_Bcast(reax_rexpon->gp.l,reax_rexpon->gp.n_global,MPI_DOUBLE,0,world);
+
+    // allocate storage for atom type based data
+    MPI_Bcast(&reax_rexpon->num_atom_types,1,MPI_INT,0,world);
+    const int n = reax_rexpon->num_atom_types;
+    if (control->me != 0) {
+      memory->create(reax_rexpon->sbp,n,"reaxff_rexpon:sbp");
+      memory->create(reax_rexpon->tbp,n,n,"reaxff_rexpon:tbp");
+      memory->create(reax_rexpon->thbp,n,n,n,"reaxff_rexpon:thbp");
+      memory->create(reax_rexpon->hbp,n,n,n,"reaxff_rexpon:hbp");
+      memory->create(reax_rexpon->fbp,n,n,n,n,"reaxff_rexpon:fbp");
+    }
+
+    // broadcast type specific force field data
+    MPI_Bcast(&(reax_rexpon->sbp[0]),sizeof(single_body_parameters)*n,MPI_CHAR,0,world);
+    MPI_Bcast(&(reax_rexpon->tbp[0][0]),sizeof(two_body_parameters)*n*n,MPI_CHAR,0,world);
+    MPI_Bcast(&(reax_rexpon->thbp[0][0][0]),sizeof(three_body_header)*n*n*n,MPI_CHAR,0,world);
+    MPI_Bcast(&(reax_rexpon->hbp[0][0][0]),sizeof(hbond_parameters)*n*n*n,MPI_CHAR,0,world);
+    MPI_Bcast(&(reax_rexpon->fbp[0][0][0][0]),sizeof(four_body_header)*n*n*n*n,MPI_CHAR,0,world);
+
+    // apply global parameters to global control settings
+
+    control->bo_cut    = 0.01 * reax_rexpon->gp.l[29];
+    control->nonb_low  = reax_rexpon->gp.l[11];
+    control->nonb_cut  = reax_rexpon->gp.l[12];
+  }
+#undef THROW_ERROR
+}
diff -urN src/reaxff_rexpon_forces.cpp src_puxh/reaxff_rexpon_forces.cpp
--- src/reaxff_rexpon_forces.cpp	1970-01-01 09:00:00.000000000 +0900
+++ src_puxh/reaxff_rexpon_forces.cpp	2026-07-26 09:14:10.015073158 +0900
@@ -0,0 +1,397 @@
+// clang-format off
