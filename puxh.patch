+{
+  weightflag = 0;
+  writedata = 1;
+}
+
+/* ---------------------------------------------------------------------- */
+
+DihedralCharmm::~DihedralCharmm()
+{
+  if (allocated && !copymode) {
+    memory->destroy(setflag);
+    memory->destroy(k);
