+    rvec dvec_jk;
+    hbond_parameters *hbp;
+    bond_order_data *bo_ij;
+    bond_data *pbond_ij;
+    far_neighbor_data *nbr_jk;
+    reax_rexpon_list *bonds, *hbonds;
+    bond_data *bond_list;
