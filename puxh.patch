+  int newton_pair = force->newton_pair;
+
+  vector_renew(kappas_local, ndim);
+  vector_renew(kappabs_local, ndim);
+  double **x, SMALL = 0.0001;
+  double dx, dy, dz, r_sqr;
+  x = atom->x;
+
+  ilist = list->ilist;
+  firstneigh = list->firstneigh;
+  numneigh = list->numneigh;
+  for (ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+		for (jj = 0; jj < natoms; jj++) {
+	    itag = tag[i]; 
+  	  idem_i = idem[atom->type[i]];
+			jtag = jj + 1;
+			j = atom->map(jtag);
+  	  idem_j = idem[atom->type[j]];
+      kappas_local[itag * natoms + jtag] = (idem_i + idem_j) / 2;
+      kappabs_local[itag * natoms + jtag] = (idem_i - idem_j) / 2;
+		}
+  }
+
+  MPI_Allreduce(&(kappas_local[0]), &(kappas[0]), ndim * ndim, MPI_DOUBLE, MPI_SUM, world);
+  MPI_Allreduce(&(kappabs_local[0]), &(kappabs[0]), ndim * ndim, MPI_DOUBLE, MPI_SUM, world);
+}
