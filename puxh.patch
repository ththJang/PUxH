+    utils::sfread(FLERR, &swa, sizeof(double), 1, fp, nullptr, error);
+    utils::sfread(FLERR, &swb, sizeof(double), 1, fp, nullptr, error);
+  }
+  MPI_Bcast(&swa,1,MPI_DOUBLE,0,world);
+  MPI_Bcast(&swb,1,MPI_DOUBLE,0,world);
