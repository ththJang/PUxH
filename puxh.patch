+/* ---------------------------------------------------------------------- */
+
+int FixPSQ::CG(double *b, double *x) // *b: chis, Sparse_CRS x: qifj_CRS
+{
+  int i, j, imax;
+  double tmp, alpha, beta, b_norm;
+  double sig_old, sig_new;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  int natoms = atom->natoms;
+  int ndim = natoms + 1;
+  int vecn = ndim * ndim;
+  tagint *tag = atom->tag;
+  int jnum, itag, jtag, ktag;
+  double *q = atom->q;
+  double qi, qj;
+  double q_new, q_old;
+
+  imax = numCG;
+
+  pack_flag = 1;
+
+  // q_ij, and dV/dQ_i and kappa
+  int nn, ii, jj, k, l, m;
+  double qf_i, qf_j;
+  nn = list->inum;
+  ilist = list->ilist;
+  firstneigh = list->firstneigh;
+  numneigh = list->numneigh;
+
+  int nlocal = atom->nlocal;
+  int *mask = atom->mask;
+  int newton_pair = force->newton_pair, loop;
+  double criteria;
+  int me = comm->me;
+  int cnt = disp_n_nz_rnk[me];
+  int nbonds1, nbonds2;
+  tagint **bond_atom = atom->bond_atom;
+
+  /* initial */
+  calculate_Q(); 
+  Vcmatrix();
+  vector_CRS_renew(Ad_CRS_local_val, n_nz);
+  Admatrix(x);
+  /* initial */
+
+  vector_renew(Vcis_local, 1);
+  vector_CRS_renew(xnew_CRS_local_val, n_nz); // pre-condition
+
+  for (int ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    q_new = 0;
+    itag = tag[i]; 
+    nbonds1 = atom->num_bond[i];
+    nbonds2 = counter_num_bond[itag];
+    cnt = row_ptr[itag - 1];
+    for (jj = 0; jj < nbonds1; jj++) {
+      j = bond_atom[i][jj];
+      p[cnt] = x[cnt];
+      r[cnt] = b[cnt] - Ad_CRS_local_val[cnt];
+      xnew_CRS_local_val[cnt] = r[cnt];
+      q_new += xnew_CRS_local_val[cnt];
+      cnt++;
+    }
+    for (jj = 0; jj < nbonds2; jj++) {
+      j = counter_bond_atom[itag][jj];
+      p[cnt] = x[cnt];
+      r[cnt] = b[cnt] - Ad_CRS_local_val[cnt];
+      xnew_CRS_local_val[cnt] = r[cnt];
+      q_new += xnew_CRS_local_val[cnt];
+      cnt++;
+    }
+    q[i] = q_new;
+  }
+
+  pack_flag = 4;
+  comm->forward_comm(this); // Dist_vector( atom->q );
+
+  MPI_Allreduce(&(xnew_CRS_local_val[0]), &(x[0]), n_nz, MPI_DOUBLE, MPI_SUM, world);
+
+
+  b_norm = parallel_dot_CRS(b, b); // for the sake of using calculate_Q
+  criteria = b_norm;
+  sig_new = parallel_dot_CRS(r, r);
+  vector_CRS_renew(Ad_CRS_local_val, n_nz); // pre-condition
+
+  for (loop = 1; loop < imax && sqrt(sig_new) / criteria > tolerance; ++loop) {
+
+    Vcmatrix();
+    Admatrix(x);
+    b_norm = parallel_dot_CRS(x, Ad_CRS_local_val);
+    sig_new = parallel_dot_CRS(r, r);
+    alpha = sig_new / b_norm;
+
+    for (int ii = 0; ii < nn; ii++) {
+      i = ilist[ii];
+      if (!(mask[i] & groupbit))
+        continue;
+      itag = tag[i]; 
+      nbonds1 = atom->num_bond[i];
+      nbonds2 = counter_num_bond[itag];
+      cnt = row_ptr[itag - 1];
+      for (jj = 0; jj < nbonds1; jj++) {
+        j = bond_atom[i][jj];
+        p[cnt] += alpha * x[cnt];
+        r[cnt] -= alpha * Ad_CRS_local_val[cnt];
+        cnt++;
+      }
+      for (jj = 0; jj < nbonds2; jj++) {
+        j = counter_bond_atom[itag][jj];
+        p[cnt] += alpha * x[cnt];
+        r[cnt] -= alpha * Ad_CRS_local_val[cnt];
+        cnt++;
+      }
+    }
+
+
+    sig_old = sig_new;
+    sig_new = parallel_dot_CRS(r, r);
+    beta = sig_new / sig_old;
+    for (int ii = 0; ii < nn; ii++) {
+      i = ilist[ii];
+      if (!(mask[i] & groupbit))
+        continue;
+      q_new = 0;
+      itag = tag[i]; 
+      nbonds1 = atom->num_bond[i];
+      nbonds2 = counter_num_bond[itag];
+      cnt = row_ptr[itag - 1];
+      for (jj = 0; jj < nbonds1; jj++) {
+        j = bond_atom[i][jj];
+        xnew_CRS_local_val[cnt] = r[cnt] + beta * x[cnt];
+        q_new += xnew_CRS_local_val[cnt];
+        cnt++;
+      }
+      for (jj = 0; jj < nbonds2; jj++) {
+        j = counter_bond_atom[itag][jj];
+        xnew_CRS_local_val[cnt] = r[cnt] + beta * x[cnt];
+        q_new += xnew_CRS_local_val[cnt];
+        cnt++;
+      }
+      q[i] = q_new;
+    }
+
+    pack_flag = 4;
+    comm->forward_comm(this); 
+
+    MPI_Allreduce(&(xnew_CRS_local_val[0]), &(x[0]), n_nz, MPI_DOUBLE, MPI_SUM, world); 
+
+    vector_renew(Vcis_local, 1);
+
+    vector_CRS_renew(Ad_CRS_local_val, n_nz);
+
+  } // CG end
+
+  for (int ii = 0; ii < nn; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    q_new = 0;
+    itag = tag[i]; 
+    nbonds1 = atom->num_bond[i];
+    nbonds2 = counter_num_bond[itag];
+    cnt = row_ptr[itag - 1];
+    for (jj = 0; jj < nbonds1; jj++) {
+      j = bond_atom[i][jj];
+      q_new += p[cnt];
+      Ad_CRS_local_val[cnt] = p[cnt];
+      cnt++;
+    }
+    for (jj = 0; jj < nbonds2; jj++) {
+      j = counter_bond_atom[itag][jj];
+      q_new += p[cnt];
+      Ad_CRS_local_val[cnt] = p[cnt];
+      cnt++;
+    }
+    q[i] = q_new + iniq[atom->type[i]];
+  }
+
+
+  pack_flag = 4;
+  comm->forward_comm(this); // Dist_vector( atom->q );
+
+  MPI_Allreduce(&(Ad_CRS_local_val[0]), &(qifj_CRS_val[0]), n_nz, MPI_DOUBLE, MPI_SUM, world); 
+
+  if (loop >= imax && comm->me == 0) {
+    char str[128];
+    sprintf(str, "Fix pqeq CG convergence failed after %d iterations "
+                 "at " BIGINT_FORMAT " step",
+            loop, update->ntimestep);
+    error->warning(FLERR, str);
+  }
+
+  return loop;
+}
