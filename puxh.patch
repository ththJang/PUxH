+            // E_Ryd(r_ij) (15), from JCP 149 174502 (2018)
+            part1 = -D0 * exp(-b0*a0*(r_ij-r0));
+            part2 = c0 + b0*a0*(r_ij-r0)*(c0+a0*(r_ij-r0)*(c0+a0*(r_ij-r0)));
+            e_qm = bos*exp(twbp->bop*(1-pow(bos,twbp->bop2))) * part1 * part2;
