+  void Hydrogen_Bonds(reax_rexpon_system *system, control_params *control, simulation_data *data, storage *workspace, reax_rexpon_list **lists)
+  {
+    int  i, j, k, pi, pk, natoms;
+    int  type_i, type_j, type_k;
+    int  start_j, end_j, hb_start_j, hb_end_j;
+    int  hblist[MAX_BONDS];
+    int  itr, top;
+    int  num_hb_intrs = 0;
+    double r_ij, r_jk, theta, cos_theta, sin_xhz2, sin_xhz4, cos_xhz1, sin_theta2;
+    double e_hb, exp_hb2, exp_hb3, exp_hb4, CEhb1, CEhb2, CEhb3;
