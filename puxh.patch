+double FixPSQ::parallel_dot(double *v1, double *v2, int n) {
+  int i, j;
+  double my_dot, res;
+
+  int ii, jj, inum, jnum, itag, jtag;
+  int me = comm->me;
+  int *ilist, *jlist, *numneigh, **firstneigh;
+  int *mask = atom->mask;
+  int nlocal = atom->nlocal;
+  tagint *tag = atom->tag;
+  tagint **bond_atom = atom->bond_atom;
+  my_dot = 0.0;
+  res = 0.0;
+  inum = list->inum;
+  ilist = list->ilist;
+  numneigh = list->numneigh;
+  firstneigh = list->firstneigh;
+  int start, end;
+  int natoms = atom->natoms;
+  int ndim = natoms + 1;
+  int nbonds1, nbonds2;
+
+  for (int ii = 0; ii < inum; ii++) {
+    i = ilist[ii];
+    if (!(mask[i] & groupbit))
+      continue;
+    itag = tag[i]; // itag global index
+    nbonds1 = atom->num_bond[i];
+    nbonds2 = counter_num_bond[itag];
+    for (jj = 0; jj < nbonds1; jj++) {
+      j = bond_atom[i][jj];
+      my_dot += v1[itag * natoms + j] * v2[itag * natoms + j];
+    }
+    for (jj = 0; jj < nbonds2; jj++) {
+      j = counter_bond_atom[itag][jj];
+      my_dot += v1[itag * natoms + j] * v2[itag * natoms + j];
+    }
+  }
+
+  MPI_Allreduce(&my_dot, &res, 1, MPI_DOUBLE, MPI_SUM, world);
+  return res;
+}
